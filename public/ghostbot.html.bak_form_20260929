      const totalEl = document.getElementById('heroSlotsTotalCount');
      const atCapEl = document.getElementById('heroAtCapacityBadge');
      if (usedEl) usedEl.textContent = usedSlots;
      if (totalEl) totalEl.textContent = totalSlots;
      if (atCapEl) {
        atCapEl.style.display = usedSlots >= totalSlots ? 'inline-flex' : 'none';
        atCapEl.innerHTML = isAr ? '<span>●</span> ممتلئ بالكامل' : '<span>●</span> AT CAPACITY';
      }

      // Segmented Micro-LED Slot Grid (20-segment capacity tracker)
      const ledGrid = document.getElementById('heroSlotsLedGrid');
      if (ledGrid) {
        const totalSegs = 20;
        const filledSegs = totalSlots > 0 ? Math.min(totalSegs, Math.round((usedSlots / totalSlots) * totalSegs)) : 0;
        let segHtml = '';
        for (let i = 0; i < totalSegs; i++) {
          const isFilled = i < filledSegs;
          const isWarn = isFilled && (usedSlots >= totalSlots);
          segHtml += `<div class="hero-led-segment ${isFilled ? (isWarn ? 'active warn' : 'active') : ''}"></div>`;
        }
        ledGrid.innerHTML = segHtml;
      }

      // 5. License Expiry, Live Countdown & Quantum Radial Reactor Gauge
      const now = Date.now();
      const durationDays = unit.durationDays || 30;
      const totalMs = durationDays * 24 * 60 * 60 * 1000;
      if (!unit.expiresAt) {
        unit.expiresAt = (unit.purchasedAt || now) + totalMs;
      }

      const remainingMs = Math.max(0, unit.expiresAt - now);
      const days = Math.floor(remainingMs / (24 * 60 * 60 * 1000));
      const hours = Math.floor((remainingMs % (24 * 60 * 60 * 1000)) / (60 * 60 * 1000));
      const mins = Math.floor((remainingMs % (60 * 60 * 1000)) / (60 * 1000));
      const secs = Math.floor((remainingMs % (60 * 1000)) / 1000);

      const countEl = document.getElementById('heroLicenseCountdown');
      if (countEl) {
        countEl.textContent = `${days}d ${String(hours).padStart(2, '0')}h ${String(mins).padStart(2, '0')}m ${String(secs).padStart(2, '0')}s`;
