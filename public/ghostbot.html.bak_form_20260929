      // Percentage of remaining license for Quantum Radial Reactor
      const pct = Math.min(100, Math.max(0, (remainingMs / totalMs) * 100));
      const dialCircle = document.getElementById('heroReactorDialCircle');
      if (dialCircle) {
        const circumference = 201; // 2 * PI * 32
        const offset = circumference - (circumference * (pct / 100));
        dialCircle.style.strokeDashoffset = offset;
      }

      const pctEl = document.getElementById('heroReactorPercent');
      if (pctEl) {
        pctEl.textContent = `${Math.round(pct)}%`;
      }

      const expEl = document.getElementById('heroLicenseExpires');
      if (expEl) {
        const expDate = new Date(unit.expiresAt);
        expEl.textContent = isAr 
          ? `ينتهي في ${expDate.toLocaleDateString('ar-EG')}` 
          : `Expires ${expDate.toLocaleDateString('en-US')}, ${expDate.toLocaleTimeString('en-US')}`;
      }

      const planEl = document.getElementById('heroLicensePlanDesc');
      if (planEl) {
        const tierName = (unit.tier || 'BASIC').toLowerCase();
        const capTier = tierName.charAt(0).toUpperCase() + tierName.slice(1);
        planEl.textContent = isAr 
          ? `باقة ${capTier === 'Basic' ? 'أساسية' : capTier} • ${totalSlots} حُكّام` 
          : `${capTier} Tier • ${totalSlots} Governors`;
      }
    }

    let botConsoleBuffers = {};
    let seenLogLinesPerBot = {};

    function selectUnit(id) {
      const oldId = activeUnitId;
      const consoleEl = document.getElementById('consoleBody');
      if (oldId && consoleEl) {
        botConsoleBuffers[oldId] = consoleEl.innerHTML;
      }

      activeUnitId = String(id);
      searchVal = '';
      const searchInputs = document.querySelectorAll('input[data-i18n-placeholder="searchPlaceholder"]');
      searchInputs.forEach(inp => { inp.value = ''; });

      if (consoleEl) {
        consoleEl.innerHTML = botConsoleBuffers[activeUnitId] || '';
      }

      if (!seenLogLinesPerBot[activeUnitId]) {
        seenLogLinesPerBot[activeUnitId] = new Set();
      }

      // Dedicated dynamic URL routing & parent synchronisation
      try {
        window.history.replaceState({ botId: activeUnitId }, '', `/bots/${activeUnitId}`);
      } catch (e) {}
