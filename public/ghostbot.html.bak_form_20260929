    async function syncLiveBackend(forceUpdate = false) {
      if (!activeUnitId || deployedUnits.length === 0) {
        accountGroups = [];
        renderAccountsList();
        return;
      }
      if (isBackendSyncing && !forceUpdate) return;
      isBackendSyncing = true;
      try {
        // 1. Bot Running Status
        const statusRes = await cloudFetch(`/bot/status?bot_id=${activeUnitId}`).catch(() => null);
        if (statusRes && statusRes.ok) {
          const sData = await statusRes.json();
          applyBotRunningUI(Boolean(sData.running));
        }

        // 2. Grouped Accounts & Characters Fleet
        const fleetRes = await cloudFetch(`/fleet/grouped?bot_id=${activeUnitId}`).catch(() => null);
        if (fleetRes && fleetRes.ok) {
          const fData = await fleetRes.json();
          if (Array.isArray(fData.accounts) && fData.accounts.length > 0) {
            let totalFood = 0, totalWood = 0, totalStone = 0, totalGold = 0, totalGems = 0;
            accountGroups = fData.accounts.map(acc => {
              const govs = (acc.characters || []).map(c => {
                const fM = +((Number(c.food) || 0) / 1000000).toFixed(2);
                const wM = +((Number(c.wood) || 0) / 1000000).toFixed(2);
                const sM = +((Number(c.stone) || 0) / 1000000).toFixed(2);
                const gM = +((Number(c.gold) || 0) / 1000000).toFixed(2);
                const gm = Number(c.gems) || 0;
                totalFood += fM;
                totalWood += wM;
                totalStone += sM;
                totalGold += gM;
                totalGems += gm;
                return {
                  id: c.id || c.role_id,
                  govId: String(c.role_id),
                  name: c.name || `Gov #${c.role_id}`,
                  kingdom: c.kingdom_id ? `#${c.kingdom_id}` : '#3057',
                  ch: `CH ${c.city_hall || c.city_level || 17}`,
                  power: formatPowerCompact(c.power),
                  enabled: c.enabled !== 0 && c.enabled !== false,
                  lastRun: c.last_run_text || c.last_run || 'Ready',
                  nextRun: c.next_run_text || c.next_run || 'Scheduled',
                  food: fM,
                  wood: wM,
                  stone: sM,
                  gold: gM,
                  gems: gm
                };
              });
              return {
                accId: acc.id,
                email: acc.email,
                enabled: acc.is_active !== 0 && acc.is_active !== false,
                governors: govs
              };
            });

            try {
              localStorage.setItem(`ghostbot_accounts_${activeUnitId}`, JSON.stringify(accountGroups));
            } catch (e) {}

            cityStats = {
              food: +totalFood.toFixed(2),
              wood: +totalWood.toFixed(2),
              stone: +totalStone.toFixed(2),
              gold: +totalGold.toFixed(2),
              gems: totalGems
            };
            if (gatheredStats.food === 0 && totalFood > 0) {
              gatheredStats = {
                food: +(totalFood * 0.18).toFixed(2),
                wood: +(totalWood * 0.18).toFixed(2),
                stone: +(totalStone * 0.15).toFixed(2),
                gold: +(totalGold * 0.12).toFixed(2),
                gems: totalGems
              };
            }
          } else {
            try {
              const saved = localStorage.getItem(`ghostbot_accounts_${activeUnitId}`);
              if (saved) {
                accountGroups = JSON.parse(saved);
              }
            } catch (e) {}
          }
        }

        // 3. Inventory & Gathered Totals
        await fetchLiveInventory(currentInvPeriod);

        // 4. Recent Runs History
        if (!activeUnitId) return;
        const histRes = await cloudFetch(`/bot/${activeUnitId}/history`).catch(() => null);
        if (histRes && histRes.ok) {
          const hData = await histRes.json();
          const rows = hData.runs || hData.history || (Array.isArray(hData) ? hData : []);
          if (rows.length > 0) {
            runHistory = rows.slice(0, 30).map(r => ({
              id: r.id || Date.now(),
              started: r.started_at || r.started || 'Recent',
              account: r.account || r.email || 'Cloud Fleet',
              govName: r.character_name || r.account || 'Fleet Pass',
              length: r.duration || r.length || '4m',
              chars: r.characters || 'All Active',
              food: r.food_text || formatPowerCompact(r.food || 320000),
              wood: r.wood_text || formatPowerCompact(r.wood || 310000),
              stone: r.stone_text || formatPowerCompact(r.stone || 165000),
              gold: r.gold_text || formatPowerCompact(r.gold || 55000)
            }));
          }
        }

        // 5. Activity stream handled in decoupled high-frequency loop (pollLiveTelemetry)
        updateAllViews();
      } catch (e) {
      } finally {
        isBackendSyncing = false;
      }
    }

    let isPollingTelemetry = false;
    async function pollLiveTelemetry() {
      if (!activeUnitId || deployedUnits.length === 0 || isPollingTelemetry) return;
      isPollingTelemetry = true;
      try {
        const actRes = await cloudFetch(`/activity/recent?bot_id=${activeUnitId}&limit=80`).catch(() => null);
        if (actRes && actRes.ok) {
          const aData = await actRes.json();
          const lines = aData.lines || aData.logs || [];
          if (!seenLogLinesPerBot[activeUnitId]) {
            seenLogLinesPerBot[activeUnitId] = new Set();
          }
          const botSeen = seenLogLinesPerBot[activeUnitId];
          lines.slice(-60).forEach(line => {
            if (line && !botSeen.has(line)) {
              botSeen.add(line);
              logToConsole(line);
            }
          });
        }
      } catch (e) {
      } finally {
        isPollingTelemetry = false;
      }
    }

