    function logToConsole(message, rawTime = null) {
      const body = document.getElementById('consoleBody');
      if (!body) return;
      let rawOriginal = String(message || '').trim();
      if (!rawOriginal) return;

      const lower = rawOriginal.toLowerCase();
      // Suppress only low-level network ping lines
      if (
        lower.includes('wire-ping') ||
        lower.includes('config-sync') ||
        lower.includes('config-target') ||
        lower.includes('gateway ack') ||
        lower.includes('handshake complete')
      ) {
        return;
      }

      // Strip developer internal socket wire prefixes
      let msg = rawOriginal.replace(/^\[(WIRE-OK|WIRE-STANDBY|WIRE-WARN|ENGINE-START|CHECKOUT-SUCCESS|ACCOUNT-LINK|ACCOUNT-DELETE)\]\s*/i, '').trim();
      if (!msg) return;

      // Extract client-side local timezone
      let timeStr = '';
      if (rawTime) {
        try {
          const d = new Date(rawTime);
          if (!isNaN(d.getTime())) {
            timeStr = d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
          }
        } catch (e) {}
      }

      const endTimestampMatch = msg.match(/\s+(\d{1,2}:\d{2}:\d{2}(?:\s*[AP]M)?)$/i);
      if (endTimestampMatch) {
        if (!timeStr) timeStr = endTimestampMatch[1];
        msg = msg.replace(/\s+\d{1,2}:\d{2}:\d{2}(?:\s*[AP]M)?$/i, '').trim();
      }

      const startTimestampMatch = msg.match(/^(\d{1,2}:\d{2}:\d{2}\s*(?:AM|PM)?)\s+(.*)$/i);
      if (startTimestampMatch) {
        if (!timeStr) timeStr = startTimestampMatch[1];
        msg = startTimestampMatch[2].trim();
      }

      msg = msg.replace(/^\.\.\.\s*(?:AM|PM)?\s*/i, '').trim();

      if (!timeStr) {
        timeStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
      }

      // Extract governor capsule if present e.g. [16 KD] or [NucroShop7]
      let govTag = null;
      const govMatch = msg.match(/^\[([^\]]+)\]\s*(.*)$/);
      if (govMatch && !['GATHER', 'TRAIN', 'ALLIANCE', 'HOSPITAL', 'CLAIMS', 'STAGE 1', 'STAGE 2', 'STAGE 1 COMPLETE', 'STAGE 2 COMPLETE', 'SYSTEM', 'جمع الموارد', 'تجنيد القوات', 'تقنيات التحالف', 'المشفى', 'المكافآت', 'المرحلة 1', 'المرحلة 2', 'اكتملت المرحلة 1', 'اكتملت المرحلة 2', 'النظام'].includes(govMatch[1].trim())) {
        govTag = govMatch[1].trim();
        msg = govMatch[2].trim();
      }

      // Determine category and icon based on original message
      const lowerClean = msg.toLowerCase();
      const isAr = currentLang === 'ar';
      let category = 'system';
      let iconHref = '#ghostbot-mascot';
      let catLabel = isAr ? 'النظام' : 'SYSTEM';

      if (
        lowerClean.includes('march') ||
        lowerClean.includes('gather') ||
        lowerClean.includes('harvest') ||
        lowerClean.includes('stone') ||
        lowerClean.includes('wood') ||
        lowerClean.includes('food') ||
        lowerClean.includes('gold') ||
        lowerClean.includes('gem') ||
        lowerClean.includes('mine') ||
        lowerClean.includes('quarry') ||
        lowerClean.includes('lumber') ||
        lowerClean.includes('rss') ||
        msg.includes('🌾') ||
        lowerClean.includes('جمع') ||
        lowerClean.includes('الموارد')
      ) {
        category = 'gather';
        iconHref = '#icon-harvest-grain';
        catLabel = isAr ? 'جمع الموارد' : 'GATHER';
      } else if (
        lowerClean.includes('train') ||
        lowerClean.includes('troop') ||
        lowerClean.includes('barrack') ||
        lowerClean.includes('archery') ||
        lowerClean.includes('stable') ||
        lowerClean.includes('infantry') ||
        lowerClean.includes('cavalry') ||
        lowerClean.includes('siege') ||
        msg.includes('⚔️') ||
        lowerClean.includes('تدريب') ||
        lowerClean.includes('تجنيد')
      ) {
        category = 'train';
        iconHref = '#icon-swords-crossed';
        catLabel = isAr ? 'تجنيد القوات' : 'TRAINING';
      } else if (
        lowerClean.includes('alliance') ||
        lowerClean.includes('donate') ||
        lowerClean.includes('tech') ||
        lowerClean.includes('help') ||
        lowerClean.includes('chest') ||
        lowerClean.includes('gift') ||
        msg.includes('🔬') ||
        lowerClean.includes('تحالف') ||
        lowerClean.includes('تبرع')
      ) {
        category = 'alliance';
        iconHref = '#icon-handshake-alliance';
        catLabel = isAr ? 'تقنيات التحالف' : 'ALLIANCE';
      } else if (
        lowerClean.includes('city') ||
        lowerClean.includes('collect') ||
        lowerClean.includes('quest') ||
        lowerClean.includes('reward') ||
        lowerClean.includes('vip') ||
        lowerClean.includes('chronicle') ||
        lowerClean.includes('merchant') ||
        msg.includes('🎁') ||
        lowerClean.includes('مكافآت') ||
        lowerClean.includes('إنتاج')
      ) {
        category = 'city';
        iconHref = '#icon-castle-fort';
        catLabel = isAr ? 'المكافآت' : 'CLAIMS';
      } else if (
        lowerClean.includes('heal') ||
        lowerClean.includes('hospital') ||
        lowerClean.includes('shield') ||
        lowerClean.includes('barb') ||
        lowerClean.includes('combat') ||
        lowerClean.includes('attack') ||
        msg.includes('🏥') ||
        lowerClean.includes('مشفى') ||
        lowerClean.includes('مستشفى') ||
        lowerClean.includes('علاج')
      ) {
        category = 'combat';
        iconHref = '#icon-hospital-cross';
        catLabel = isAr ? 'المشفى' : 'HOSPITAL';
      }

      // Apply dynamic translation to target language
      const translatedMsg = translateLogMessage(msg, currentLang);

      // Format highlights for targets, resource levels, and coordinates
      let formattedMsg = translatedMsg
        .replace(/\b(Stone\s+L\d+|Food\s+L\d+|Wood\s+L\d+|Gold\s+L\d+|Gems?\s+L\d+|Level\s+\d+|CH\s+\d+)\b/gi, '<span class="highlight-target">$1</span>')
        .replace(/(\(\d{1,4},\s*\d{1,4}\))/g, '<span class="highlight-coord">$1</span>')
        .replace(/\b(T[1-5]\s+[A-Za-z]+|Infantry|Cavalry|Archers|Siege)\b/gi, '<span class="highlight-resource">$1</span>');

      const row = document.createElement('div');
      row.className = `cyber-log-row cat-border-${category}`;
      row.dataset.category = category;
      row.dataset.rawMsg = msg;
      row.dataset.rawTime = timeStr;
      if (govTag) row.dataset.govTag = govTag;
      row.style.direction = isAr ? 'rtl' : 'ltr';
      row.style.textAlign = isAr ? 'right' : 'left';

      let html = `<span class="cyber-log-time">[${timeStr}]</span>`;
      html += `
        <span class="cyber-log-badge badge-${category}">
          <svg width="11" height="11" style="vertical-align:middle;"><use href="${iconHref}"/></svg>
          <span>${catLabel}</span>
        </span>
      `;
      if (govTag) {
        html += `<span class="cyber-log-gov">${govTag}</span>`;
      }
      html += `<span class="cyber-log-text">${formattedMsg}</span>`;

      row.innerHTML = html;

      // Apply current filter visibility
      if (activeConsoleFilter !== 'all' && activeConsoleFilter !== category) {
        row.style.display = 'none';
      }

      body.appendChild(row);

      // Keep maximum buffer of 350 micro-cards
      while (body.children.length > 350) {
        body.removeChild(body.firstChild);
      }

      if (activeUnitId) {
        botConsoleBuffers[activeUnitId] = body.innerHTML;
      }

      // Update packet telemetry counter
      totalConsolePackets++;
      const pCount = document.getElementById('consolePacketCount');
      if (pCount) pCount.textContent = totalConsolePackets.toLocaleString();

      if (isAutoScrollEnabled) {
        body.scrollTo({ top: body.scrollHeight, behavior: 'smooth' });
      }
    }

    // ================= TENANT PROFILE & SIGN OUT =================
    let currentTenantUser = null;
    async function syncTenantUser() {
      try {
        const res = await fetch('/api/backend/api/tenant/me');
        if (res.ok) {
          const data = await res.json();
          const prevUserId = currentTenantUser ? currentTenantUser.user_id : null;
          currentTenantUser = data;
          if (prevUserId && prevUserId !== data.user_id) {
            // User switched — purge all previous tenant state
            seenLogLines.clear();
            accountGroups = [];
            runHistory = [];
            document.getElementById('consoleBody').innerHTML = '';
          }
          if (data.username || data.avatar_url) {
            try {
              localStorage.setItem('ghostbot_guest_user', JSON.stringify({
                username: data.username || 'Commander',
                email: data.email,
                avatar: data.avatar_url,
                is_pro: data.is_pro || false
              }));
            } catch (e) {}
            updateUserProfileUI();
          }

          const ovEmail = document.getElementById('ovUserEmail');
          if (ovEmail) {
            if (data.is_guest) {
              ovEmail.textContent = 'جلسة تجريبية كزائر • Guest Session';
            } else if (data.username) {
              ovEmail.textContent = `${data.username} (${data.email || 'Discord'})`;
            } else if (data.email) {
              ovEmail.textContent = data.email;
            }
          }
          if (Array.isArray(data.bots) && data.bots.length > 0) {
            deployedUnits = data.bots.map((b, idx) => ({
              id: b.id,
              seqId: b.seqId !== undefined ? b.seqId : idx,
              name: b.name || `Farm Bot #${b.seqId !== undefined ? b.seqId : idx}`,
              slots: b.slots || 20,
              tier: (b.tier || b.bot_type || 'BASIC').toUpperCase(),
              botType: (b.bot_type === 'gem' || (b.name && b.name.toLowerCase().includes('gem'))) ? 'gem' : (b.bot_type === 'builder' ? 'builder' : 'farm'),
              durationDays: b.durationDays || 30,
              purchasedAt: b.purchasedAt || Date.now(),
              expiresAt: b.expiresAt || (Date.now() + ((b.durationDays || 30) * 86400000))
            }));
            try {
              localStorage.setItem('ghostbot_deployed_units', JSON.stringify(deployedUnits));
            } catch (e) {}
            if (deployedUnits.length > 0) {
              const urlParams = new URLSearchParams(window.location.search);
              const urlBotId = urlParams.get('bot_id') || (window.location.pathname.startsWith('/bots/') ? window.location.pathname.replace('/bots/', '').split('/')[0] : null);
              if (urlBotId && deployedUnits.some(u => String(u.id) === String(urlBotId))) {
                activeUnitId = String(urlBotId);
              } else if (!deployedUnits.some(u => u.id === activeUnitId)) {
                activeUnitId = deployedUnits[0].id;
              }
              renderDeployedUnits();
              renderOverviewFleet();
              selectUnit(activeUnitId);
            }
          } else {
            // Check if local storage has existing bot units — preserve and auto-sync to Supabase cloud
            let localUnits = [];
            try {
              localUnits = JSON.parse(localStorage.getItem('ghostbot_deployed_units') || '[]');
            } catch (e) {}

            if (Array.isArray(localUnits) && localUnits.length > 0) {
              deployedUnits = localUnits;
              if (!activeUnitId && deployedUnits.length > 0) {
                activeUnitId = deployedUnits[0].id;
              }
              renderDeployedUnits();
              renderOverviewFleet();
              if (activeUnitId) selectUnit(activeUnitId);

              // Auto-backup to Supabase cloud in background
              deployedUnits.forEach(u => {
                fetch('/api/backend/api/tenants/save', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({
                    bot_id: u.id,
                    name: u.name,
                    slots: u.slots,
                    tier: (u.tier || 'basic').toLowerCase(),
                    product: u.botType === 'gem' ? 'gem-bot' : (u.botType === 'builder' ? 'farm-builder' : 'farm-bot'),
                    durationDays: u.durationDays || 30,
                    expires_at: new Date(u.expiresAt || (Date.now() + 30 * 86400000)).toISOString()
                  })
                }).catch(() => {});
              });
            } else {
              deployedUnits = [];
              activeUnitId = '';
              accountGroups = [];
              renderDeployedUnits();
              renderAccountsList();
              renderOverviewFleet();
              updateHeaderVisibility('overview');
            }
          }
          updateUserProfileUI();
          updateHeroController();
        }
      } catch (e) {}
    }

