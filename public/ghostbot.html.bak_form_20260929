    // =====================================================
    // TACTICAL CYBER-CYAN MOUSE ENGINE & INTERACTIVITY
    // =====================================================
    function initTacticalMouseEngine() {
      const ring = document.getElementById('ghostCursorRing');
      const spotlight = document.getElementById('mouseAmbientSpotlight');
      const bgImage = document.querySelector('.kingdom-bg-image');
      if (!ring || !spotlight) return;

      let mouseX = window.innerWidth / 2;
      let mouseY = window.innerHeight / 2;
      let ringX = mouseX;
      let ringY = mouseY;

      window.addEventListener('mousemove', (e) => {
        mouseX = e.clientX;
        mouseY = e.clientY;

        spotlight.style.left = `${mouseX}px`;
        spotlight.style.top = `${mouseY}px`;

        const target = e.target.closest('button, a, select, input, .side-link, .tab-btn, .sidebar-profile-card, .sidebar-brand-card, .cfg-cat-btn, .switch');
        if (target) {
          ring.classList.add('hover-lock');
        } else {
          ring.classList.remove('hover-lock');
        }

        const card = e.target.closest('.surface-card, .hero-controller-card, .sidebar-profile-card, .stat-tile, .unit-card');
        if (card) {
          const rect = card.getBoundingClientRect();
          card.style.setProperty('--mx', `${e.clientX - rect.left}px`);
          card.style.setProperty('--my', `${e.clientY - rect.top}px`);
        }

        if (bgImage) {
          const moveX = ((mouseX / window.innerWidth) - 0.5) * -14;
          const moveY = ((mouseY / window.innerHeight) - 0.5) * -14;
          bgImage.style.transform = `scale(1.05) translate3d(${moveX}px, ${moveY}px, 0)`;
        }
      }, { passive: true });

      function renderCursorLoop() {
        ringX += (mouseX - ringX) * 0.22;
        ringY += (mouseY - ringY) * 0.22;
        ring.style.left = `${ringX}px`;
        ring.style.top = `${ringY}px`;
        requestAnimationFrame(renderCursorLoop);
      }
      requestAnimationFrame(renderCursorLoop);

      window.addEventListener('mousedown', (e) => {
        ring.classList.add('clicking');
        const wave = document.createElement('div');
        wave.className = 'click-shockwave';
        wave.style.left = `${e.clientX}px`;
        wave.style.top = `${e.clientY}px`;
        document.body.appendChild(wave);
        setTimeout(() => wave.remove(), 550);
      });

      window.addEventListener('mouseup', () => {
        ring.classList.remove('clicking');
      });
    }

