    // ================= COOKIE & DISCORD PROFILE ENGINE =================
    function getCookie(name) {
      try {
        const match = document.cookie.match(new RegExp('(^|;\\s*)(' + name + ')=([^;]*)'));
        return match ? decodeURIComponent(match[3]) : null;
      } catch (e) {
        return null;
      }
    }

    function loadProfileFromCookie() {
      try {
        const cookieStr = getCookie('ghostbot_user_profile');
        if (cookieStr) {
          const p = JSON.parse(cookieStr);
          if (p && (p.username || p.avatar_url || p.user_id)) {
            currentTenantUser = currentTenantUser || {};
            if (p.username) currentTenantUser.username = p.username;
            if (p.avatar_url) currentTenantUser.avatar_url = p.avatar_url;
            if (p.user_id) currentTenantUser.user_id = p.user_id;
            if (p.email) currentTenantUser.email = p.email;
            return p;
          }
        }
      } catch (e) {}
      return null;
    }

