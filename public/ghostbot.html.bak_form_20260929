    function recalcCheckoutTotal() {
      const isBasic = checkoutState.tier === 'basic';
      const c = checkoutState.chars;

      let rate = isBasic ? 2.00 : 3.50;
      if (c >= 100) rate = isBasic ? 1.20 : 2.10;
      else if (c >= 50) rate = isBasic ? 1.40 : 2.45;
      else if (c >= 10) rate = isBasic ? 1.80 : 3.15;

      checkoutState.basePerChar = rate;
      document.getElementById('pricePerCharLabel').textContent = `$${rate.toFixed(2)} / char`;

      const monthly = c * rate;
      const total90 = (monthly * 3) * 0.85; // 15% discount
      const savings = (monthly * 3) - total90;

      document.getElementById('durPrice30').textContent = `$${monthly.toFixed(2)}`;
      document.getElementById('durPrice90').textContent = `$${total90.toFixed(2)}`;
      document.getElementById('durSaveLabel').textContent = `Save $${savings.toFixed(2)} (15% off 3x monthly)`;

      let baseTotal = checkoutState.duration === 30 ? monthly : total90;

      // Promo discount
      if (checkoutState.promoPercent > 0) {
        baseTotal = baseTotal * (1 - checkoutState.promoPercent);
      }

      // Crypto discount (5%)
      const isCrypto = checkoutState.paymentMethod !== 'paypal';
      const cryptoRow = document.getElementById('cryptoDiscountRow');
      if (isCrypto) {
        const cryptoSave = baseTotal * 0.05;
        document.getElementById('cryptoDiscountAmount').textContent = `-$${cryptoSave.toFixed(2)}`;
        if (cryptoRow) cryptoRow.style.display = 'flex';
        baseTotal = baseTotal - cryptoSave;
      } else {
        if (cryptoRow) cryptoRow.style.display = 'none';
      }

      checkoutState.total = baseTotal;
      document.getElementById('sumTotalAmount').textContent = `$${baseTotal.toFixed(2)}`;
    }

    async function confirmCheckoutPurchase() {
      const btn = document.getElementById('btnCheckoutPrimaryAction');
      if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<span>⚡ جارٍ تفعيل الوحدة وتجهيز المقاعد...</span>';
      }

      // Calculate sequential ID starting from 0:
      let nextSeq = parseInt(localStorage.getItem('ghostbot_next_seq_id') || '0', 10);
      if (isNaN(nextSeq) || nextSeq < 0) nextSeq = 0;

      // Also ensure nextSeq is greater than any existing seqId in deployedUnits
      if (Array.isArray(deployedUnits)) {
        deployedUnits.forEach(u => {
          if (u.seqId !== undefined && typeof u.seqId === 'number' && u.seqId >= nextSeq) {
            nextSeq = u.seqId + 1;
          }
        });
      }

      const isNew = checkoutState.applyMode === 'new' || !checkoutState.targetBotId;
      let botSeq = isNew ? nextSeq : 0;
      if (isNew) {
        localStorage.setItem('ghostbot_next_seq_id', String(nextSeq + 1));
      } else {
        const existing = deployedUnits.find(u => u.id === checkoutState.targetBotId);
        if (existing && existing.seqId !== undefined) {
          botSeq = existing.seqId;
        }
      }

      const botIdStr = isNew ? `bot-${botSeq}` : checkoutState.targetBotId;
      const defaultName = (checkoutState.product === 'gem-bot' || checkoutState.productId === 'gem-bot')
        ? `Gem Bot #${botSeq}`
        : (checkoutState.productId === 'farm-builder' ? `Farm Builder #${botSeq}` : `Farm Bot #${botSeq}`);

      const unitName = checkoutState.applyMode === 'new'
        ? (checkoutState.newBotName || defaultName)
        : (checkoutState.targetBotName || defaultName);

      const isGemProduct = (checkoutState.productId && checkoutState.productId.includes('gem')) || unitName.toLowerCase().includes('gem');
      const isBuilderProduct = (checkoutState.productId && checkoutState.productId.includes('builder')) || unitName.toLowerCase().includes('builder');

      const durationDays = checkoutState.duration || 30;
      const now = Date.now();
      const newBot = {
        id: botIdStr,
        seqId: botSeq,
        name: unitName,
        slots: checkoutState.chars,
        tier: checkoutState.tier.toUpperCase(),
        botType: isGemProduct ? 'gem' : (isBuilderProduct ? 'builder' : 'farm'),
        durationDays: durationDays,
        purchasedAt: now,
        expiresAt: now + (durationDays * 24 * 60 * 60 * 1000)
      };

      try {
        await fetch('/api/backend/api/tenants/save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            bot_id: newBot.id,
            id: newBot.id,
            name: newBot.name,
            slots: newBot.slots,
            tier: newBot.tier.toLowerCase(),
            product: newBot.botType === 'gem' ? 'gem-bot' : (newBot.botType === 'builder' ? 'farm-builder' : 'farm-bot'),
            durationDays: newBot.durationDays,
            expires_at: new Date(newBot.expiresAt).toISOString()
          })
        }).catch(() => {});
        await fetch(`/api/backend/api/tenants/${encodeURIComponent(newBot.id)}/ensure`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            slots: newBot.slots,
            defaults: { tier: newBot.tier.toLowerCase(), days: checkoutState.duration }
          })
        }).catch(() => {});
      } catch (e) {}

      // Add to local state or update existing
      const existingIdx = deployedUnits.findIndex(u => u.id === newBot.id);
      if (existingIdx >= 0) {
        deployedUnits[existingIdx].slots = newBot.slots;
        deployedUnits[existingIdx].tier = newBot.tier;
        deployedUnits[existingIdx].botType = newBot.botType;
        deployedUnits[existingIdx].durationDays = newBot.durationDays;
        deployedUnits[existingIdx].expiresAt = newBot.expiresAt;
      } else {
        deployedUnits.push(newBot);
      }

      // Elevate rank to PRO upon purchase
      localStorage.setItem('ghostbot_user_rank', 'PRO');

      try {
        localStorage.setItem('ghostbot_deployed_units', JSON.stringify(deployedUnits));
      } catch (e) {}

      activeUnitId = newBot.id;
      renderDeployedUnits();
      renderOverviewFleet();
      selectUnit(newBot.id);
      updateUserProfileUI();

      closeCheckout();
      enterBotRoom(newBot.id);
      notify(`مبروك! تم تفعيل وتجهيز ${newBot.name} بنجاح بعدد ${newBot.slots} مقاعد.`);
      logToConsole(`[CHECKOUT-SUCCESS] تم إتمام الطلب وتفعيل الوحدة السحابية: ${newBot.name} (ID #${botSeq}) بنجاح.`);

      if (btn) {
        btn.disabled = false;
        btn.innerHTML = `<span id="btnCheckoutActionLabel">${currentLang === 'ar' ? 'المتابعة لتخصيص الوحدة ←' : 'Continue to Unit Assignment →'}</span>`;
      }
    }
</script>

