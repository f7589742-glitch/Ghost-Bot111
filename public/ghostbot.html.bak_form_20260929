    async function confirmDeleteAccount() {
      const accId = pendingDeleteAccountId;
      const email = pendingDeleteAccountEmail;
      if (!accId && !email) return;
      closeDeleteAccountModal();
      notify(`جارٍ حذف الحساب ${email || accId}...`);
      logToConsole(`[ACCOUNT-DELETE] Deleting game account ${email || ''} (#${accId || ''})...`);

      try {
        const targetSlug = encodeURIComponent(email || accId);
        const res = await cloudFetch(`/accounts/${targetSlug}?email=${encodeURIComponent(email || '')}&account_id=${encodeURIComponent(accId || '')}`, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email, account_id: accId })
        });

        if (!res.ok) {
          await cloudFetch('/accounts/delete', {
            method: 'POST',
            body: JSON.stringify({ email: email, account_id: accId })
          }).catch(() => {});
        }

        // Purge from local state by email and accId
        accountGroups = accountGroups.filter(g => {
          if (email && g.email && g.email.toLowerCase() === email.toLowerCase()) return false;
          if (accId && String(g.accId) === String(accId)) return false;
          return true;
        });

        // Persist to localStorage
        if (activeUnitId) {
          try {
            localStorage.setItem(`ghostbot_accounts_${activeUnitId}`, JSON.stringify(accountGroups));
          } catch (e) {}
        }

        updateAllViews();
        renderAccountsList();
        updateHeroController();

        notify(currentLang === 'ar' ? `تم حذف الحساب ${email} وجميع حكامه بنجاح!` : `Account ${email} deleted successfully!`);
        logToConsole(`[ACCOUNT-DELETE] Account ${email} deleted from database and cloud.`);
        setTimeout(() => syncLiveBackend(true), 1500);
      } catch (e) {
        accountGroups = accountGroups.filter(g => {
          if (email && g.email && g.email.toLowerCase() === email.toLowerCase()) return false;
          if (accId && String(g.accId) === String(accId)) return false;
          return true;
        });
        if (activeUnitId) {
          try {
