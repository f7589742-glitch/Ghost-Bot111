    async function submitCaptchaAndRetrySync() {
      const tokenInput = document.getElementById('inpCaptchaToken');
      const captchaId = tokenInput ? tokenInput.value.trim() : '';
      notify('جارٍ التحقق من الكابتشا وجلب الشخصيات...');
      try {
        const res = await cloudFetch('/accounts/verify-captcha', {
          method: 'POST',
          body: JSON.stringify({
            email: pendingLinkEmail,
            password: pendingLinkPassword,
            captcha_id: captchaId || (lastCaptchaParams ? (lastCaptchaParams.challenge || lastCaptchaParams.gt) : '')
          })
        });
        const data = await res.json();
        if (data.success || data.status === 'AUTHENTICATED') {
          handleAuthSuccessAndProceedToStep2(data);
        } else {
          showLinkError(data.detail || data.error || 'فشل التحقق من الكابتشا. يرجى إعادة المحاولة.');
        }
      } catch (err) {
        await saveNewAccount();
      }
    }

