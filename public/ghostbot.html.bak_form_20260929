    function initOrUpdateCountdown(hours, resetNow = false) {
      const h = Number(hours) || Number(botConfigState.runIntervalHours) || 4;
      const totalMs = h * 3600 * 1000;
      
      if (resetNow || !nextRunTargetTimestamp || nextRunTargetTimestamp <= Date.now()) {
        nextRunTargetTimestamp = Date.now() + totalMs;
      }

      if (nextRunCountdownInterval) clearInterval(nextRunCountdownInterval);

      function tick() {
        const now = Date.now();
        let remaining = Math.max(0, nextRunTargetTimestamp - now);
        
        if (remaining <= 0) {
          if (botRunning) {
            logToConsole(currentLang === 'ar' ? '🚀 [النظام] اكتمال العداد التنازلي: بدء دورة الفحص الشاملة للمملكة تلقائياً...' : '🚀 [SYSTEM] Countdown complete: Auto-triggering fleet sweep cycle...');
            const unitKey = activeUnitId || (deployedUnits[0] ? deployedUnits[0].id : 'bot-1');
            cloudFetch(`/bot/run-now?bot_id=${unitKey}`, { method: 'POST' }).catch(() => {});
          }
          nextRunTargetTimestamp = Date.now() + totalMs;
          remaining = totalMs;
        }

        const sec = Math.floor((remaining / 1000) % 60);
        const min = Math.floor((remaining / (1000 * 60)) % 60);
        const hrs = Math.floor(remaining / (1000 * 60 * 60));

        const pad = (n) => String(n).padStart(2, '0');
        const formattedTime = `(${pad(hrs)}:${pad(min)}:${pad(sec)})`;

        const timerEl = document.getElementById('heroNextRunTimer');
        if (timerEl) {
          timerEl.textContent = formattedTime;
        }
      }

      tick();
      nextRunCountdownInterval = setInterval(tick, 1000);
    }

