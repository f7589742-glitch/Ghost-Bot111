                # Active marches sync directly from server packets (Opcode 1005 / 1023)
                elif op in (1005, 1023):
                    p2 = m.get(2) if isinstance(m, dict) else None
                    if isinstance(p2, bytes):
                        march_pattern = str(active_role_id).encode() + rb"_(\d+)_(\d+)(?:_(\d+))?"
