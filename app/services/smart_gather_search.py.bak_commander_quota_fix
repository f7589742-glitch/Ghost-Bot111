                # Resource nodes & territory from Opcode 1003
                elif op == 1003:
                    pmsg = ProtobufCodec.decode_message(m.get(2, b"")) if isinstance(m.get(2), bytes) else {}
                    # Detect enemy & friendly alliance structures (Flags, Fortresses, Sanctuaries, Passes) across all structure fields
                    for f_id in (11, 12, 13, 14, 15, 16, 17, 18, 22):
                        if f_id not in pmsg: continue
                        raw_structs = pmsg[f_id] if isinstance(pmsg[f_id], list) else [pmsg[f_id]]
                        for it_bytes in raw_structs:
                            if not isinstance(it_bytes, bytes): continue
                            try:
                                obj_e = ProtobufCodec.decode_message(it_bytes)
                                f1_e = ProtobufCodec.decode_message(obj_e.get(1, b"")) if isinstance(obj_e.get(1), bytes) else (obj_e.get(1) if isinstance(obj_e.get(1), dict) else {})
                                pos_b_e = f1_e.get(3) or obj_e.get(3) or f1_e.get(2) or obj_e.get(2)
                                if not (isinstance(pos_b_e, bytes) and len(pos_b_e) >= 10):
                                    continue
                                v1_e = struct.unpack("<f", pos_b_e[1:5])[0]
                                v2_e = struct.unpack("<f", pos_b_e[6:10])[0]
                                px_e = v1_e if pos_b_e[0] == 0x0d else v2_e
                                py_e = v2_e if pos_b_e[0] == 0x0d else v1_e
                                if px_e <= 0 or py_e <= 0:
                                    continue

                                # Extract alliance ID & tag strictly
                                e_aid = normalize_rok_alliance_id(f1_e.get(6)) or normalize_rok_alliance_id(obj_e.get(6))
                                sub7_e = ProtobufCodec.decode_message(f1_e.get(7, b"")) if isinstance(f1_e.get(7), bytes) else (f1_e.get(7) if isinstance(f1_e.get(7), dict) else {})
                                e_tag = clean_rok_tag(sub7_e.get(3, b""))
                                if not e_aid and sub7_e.get(1):
                                    e_aid = normalize_rok_alliance_id(sub7_e.get(1))

                                if not e_tag or not e_aid:
                                    ext_aid_s, _, ext_tag_s = extract_alliance_from_message(obj_e)
                                    if not e_tag and ext_tag_s:
                                        e_tag = clean_rok_tag(ext_tag_s)
                                    if not e_aid and ext_aid_s:
                                        e_aid = normalize_rok_alliance_id(ext_aid_s)

                                # Passes, Gates, Checkpoints & Holy Sites tracking (f_id 15, 17, 18, 22, 11, 16)
                                if f_id in (15, 17, 18, 22, 11, 16):
                                    obs_name = "Pass (Level 1/2/3)" if f_id in (15, 17) else ("Gate/Checkpoint" if f_id in (18, 22) else "Holy Site")
                                    pass_obstacles.append({
                                        "pos": (px_e, py_e),
                                        "f_id": f_id,
                                        "tag": e_tag or "",
                                        "aid": e_aid or 0,
                                        "name": obs_name,
                                    })

                                if not e_tag and not e_aid:
                                    continue

                                # Flag (12) = 2.4km, Fortress (14) = 3.8km, Alliance Station/Center = 2.4km, Tactical = 2.4km
                                struct_radius_km = 3.8 if f_id == 14 else 2.4

                                # Check if friendly or enemy
                                is_friendly = False
                                if active_alliance_tag and e_tag and e_tag.upper() == active_alliance_tag.upper():
