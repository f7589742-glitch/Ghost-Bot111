# Gatherers ALWAYS sort ahead of combat heroes, regardless of level
def primary_gatherer_sort_key(h: Dict[str, Any]) -> Tuple[int, int, int, int]:
    hid = int(h.get("hero_id") or h.get("id") or 0)
    is_g = 0 if (hid in GATHERING_SPECIALIST_IDS or h.get("is_gatherer") or is_gatherer(h)) else 1
