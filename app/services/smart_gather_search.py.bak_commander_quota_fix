def get_configured_march_count(rss: str, cfg: dict) -> Optional[int]:
    """Extract explicit march count for a given resource type from configuration."""
    if not isinstance(cfg, dict):
        return None
    # 1. Nested marches dict (marches: {"food": 1, "stone": 2, ...})
    marches_dict = cfg.get("marches")
    if isinstance(marches_dict, dict) and rss in marches_dict:
        try:
            return int(marches_dict[rss])
        except (ValueError, TypeError):
            pass
    # 2. Key with _marches (e.g. food_marches, stone_marches)
    if f"{rss}_marches" in cfg:
        try:
            return int(cfg[f"{rss}_marches"])
        except (ValueError, TypeError):
            pass
    # 3. Direct key if not boolean (e.g. food: 1, stone: 2)
    if rss in cfg and not isinstance(cfg[rss], bool):
        try:
            return int(cfg[rss])
        except (ValueError, TypeError):
            pass
    # 4. If direct key is boolean False, count is 0
    if rss in cfg and isinstance(cfg[rss], bool):
        if not cfg[rss]:
            return 0
    # 5. Alternative march_food, march_wood...
    if f"march_{rss}" in cfg:
        try:
            return int(cfg[f"march_{rss}"])
        except (ValueError, TypeError):
            pass
    return None

def determine_march_resource_targets(free_queues: int, config: dict, city_rss: dict) -> List[str]:
    """
    Dynamically determine resource targets for available march queues.
    
    1. Strict Zero-Allocation Exclusion:
       Any resource explicitly disabled (False) or configured with 0 marches is strictly excluded.
    2. In-City Reserve Identification:
       Identifies the allowed resource with lowest current in-city reserve.
    3. Auto-Balancing Enabled (auto_balance_lowest_rss=True):
       Lowest reserve type gets max(1, round(N * 0.65)) queues.
       Remaining queues distributed among other allowed types.
    4. Auto-Balancing Disabled (Manual Mode):
       - Strictly respects configured manual targets (base: 1 per enabled resource or explicit count).
       - If available free_queues exceeds the base manual quota (e.g. 4 queues for 3 enabled resources, +1 extra queue):
         The extra queue(s) are automatically assigned to the resource with the LOWEST in-city reserve!
         ("يشوف الإعدادات اليدوية زائد واحد وهيك يعني أقل مورد يبعث")
    """
    if free_queues <= 0 or config.get("enabled") is False:
        return []
    rss_types = ["food", "wood", "stone", "gold"]
    safe_city_rss = city_rss if isinstance(city_rss, dict) else {}

    def _rss_reserve(res):
        try:
            return int(safe_city_rss.get(res, 0) or 0)
        except Exception:
            return 0

    configured_counts: Dict[str, int] = {}
    has_explicit = False

    for r in rss_types:
        cnt = get_configured_march_count(r, config)
        if cnt is not None:
            configured_counts[r] = cnt
            has_explicit = True

    if has_explicit:
        # Strict zero-allocation: only resources with count > 0 and not boolean False are allowed
        allowed_resources = []
        for r in rss_types:
            if config.get(r) is False:
                continue
            if configured_counts.get(r, 0) > 0:
                allowed_resources.append(r)
    else:
        # Fall back to march_targets or targets
        raw = config.get("march_targets") or config.get("targets") or ["food", "wood", "stone"]
        if isinstance(raw, list) and raw:
            allowed_resources = [r for r in rss_types if r in [str(t).lower() for t in raw] and config.get(r) is not False]
        else:
            allowed_resources = ["food", "wood", "stone"]

    if not allowed_resources:
        return []

    # Sort allowed resources by in-city reserve ascending (lowest reserve first)
    sorted_by_lowest = sorted(allowed_resources, key=_rss_reserve)

    N = max(1, int(free_queues))
    auto_balance = bool(
        config.get("auto_balance_lowest_rss",
        config.get("auto_balance",
        config.get("prioritize_lowest_rss", False)))
    )

    if not auto_balance:
        # --- MANUAL MODE ---
        # Build base manual allocation list strictly according to user configured counts.
        # Interleave across requested resources (sorted by requested count descending, then lowest reserve)
        # so every requested resource gets fair distribution across available queues even when N < total.
        sorted_manual = sorted(allowed_resources, key=lambda r: (-configured_counts.get(r, 1) if has_explicit else -1, _rss_reserve(r)))
        rem_counts = {r: max(1, configured_counts.get(r, 1)) if has_explicit else 1 for r in sorted_manual}
        base_alloc = []
        while any(v > 0 for v in rem_counts.values()):
            for r in sorted_manual:
                if rem_counts[r] > 0:
                    base_alloc.append(r)
                    rem_counts[r] -= 1

        if len(base_alloc) >= N:
            return base_alloc[:N]

        # Remaining queues beyond base allocation (e.g. +1 extra queue):
        # Assign dynamically to the lowest in-city reserve among allowed resources!
        rem = N - len(base_alloc)
        extra_marches = [sorted_by_lowest[i % len(sorted_by_lowest)] for i in range(rem)]
        return base_alloc + extra_marches

    # --- AUTO-BALANCE MODE ---
    lowest_rss = sorted_by_lowest[0]
    lowest_count = max(1, round(N * 0.65))
    if lowest_count > N:
        lowest_count = N

    rem_count = N - lowest_count
    other_allowed = [r for r in allowed_resources if r != lowest_rss]

    if not other_allowed or rem_count == 0:
        return [lowest_rss] * N

    rem_marches = [other_allowed[i % len(other_allowed)] for i in range(rem_count)]
    return [lowest_rss] * lowest_count + rem_marches



def clean_rok_tag(raw_tag) -> str:
    """Normalize and strictly validate Rise of Kingdoms alliance tags (2-6 printable ASCII characters, no spaces)."""
    if not raw_tag:
        return ""
    if isinstance(raw_tag, bytes):
        try:
            raw_tag = raw_tag.decode("utf-8", "ignore")
        except Exception:
            return ""
    s = str(raw_tag).strip()
    if 2 <= len(s) <= 6 and all(33 <= ord(c) <= 126 for c in s):
        return s
    return ""


def normalize_rok_alliance_id(val) -> int:
    """In RoK protobufs, neutral/unclaimed tiles often encode -1 (9223372036854775807 or 18446744073709551615) in alliance_id fields.
    Valid RoK alliance IDs are positive 32-bit integers (1000 <= aid <= 2000000000)."""
    try:
        v = int(val or 0)
        if v < 1000 or v > 2000000000:
            return 0
        return v
    except Exception:
        return 0


def check_march_path_obstruction(
    city_pos: Tuple[float, float],
    node_pos: Tuple[float, float],
    pass_obstacles: Optional[List[dict]] = None,
    active_alliance_id: Optional[int] = None,
    active_alliance_tag: Optional[str] = None,
) -> Tuple[bool, str]:
    """
    Verifies that the direct march path from city to resource node does NOT:
    1. Cross or route through any pass (معبر), gate, or checkpoint into another zone.
    2. Target a node situated inside or directly on a pass chokepoint.
    3. Traverse impassable holy sites or enemy strongholds.
    """
    if not pass_obstacles or not city_pos or not node_pos:
        return False, ""
    try:
        cx, cy = float(city_pos[0]), float(city_pos[1])
        nx, ny = float(node_pos[0]), float(node_pos[1])
        dx = nx - cx
        dy = ny - cy
        wire_dist = math.hypot(dx, dy)
        if wire_dist < 6.0:  # < 1 km from city, impossible to cross a pass
            return False, ""

        len_sq = dx * dx + dy * dy
        if len_sq <= 0:
            return False, ""

        for obs in pass_obstacles:
            pos_obs = obs.get("pos")
            if not pos_obs or len(pos_obs) < 2:
                continue
            px, py = float(pos_obs[0]), float(pos_obs[1])
            obs_type = obs.get("f_id", 17)
            obs_name = obs.get("name", "Pass/Gate")
            obs_tag = clean_rok_tag(obs.get("tag") or "")

            # 1. Direct proximity to obstacle: is the target node right in the pass / gate zone?
            dist_node_to_obs_km = math.hypot(nx - px, ny - py) / 6.0
            # Pass structure corridor radius is ~2.0km (12 wire units)
            if dist_node_to_obs_km <= 2.0:
                tag_str = f" [{obs_tag}]" if obs_tag else ""
                return True, f"target node is inside {obs_name}{tag_str} zone ({dist_node_to_obs_km:.1f}km <= 2.0km)"

            # 2. Projection of obstacle onto march vector
            # t represents position along the ray from city (t=0.0) to node (t=1.0)
            t = ((px - cx) * dx + (py - cy) * dy) / len_sq

            # If t is between 0.04 and 0.98, the pass lies along the route between city and destination
            if 0.04 <= t <= 0.98:
                # Perpendicular distance from pass to the straight-line march trajectory
                cross_prod = abs(dx * (cy - py) - (cx - px) * dy)
                perp_dist_km = (cross_prod / math.sqrt(len_sq)) / 6.0

                # Mountain passes in RoK span ~2.5km - 3.2km corridor across the mountain chain
                pass_threshold_km = 3.0 if obs_type in (15, 17, 18) else 2.4
                if perp_dist_km <= pass_threshold_km:
                    tag_str = f" [{obs_tag}]" if obs_tag else ""
                    return True, (
                        f"march route crosses {obs_name}{tag_str} at ({px:.1f}, {py:.1f}) "
                        f"(perpendicular dist {perp_dist_km:.1f}km <= {pass_threshold_km:.1f}km, march progress {t:.0%})"
                    )

        return False, ""
    except Exception:
        return False, ""


def is_tile_accessible(node, active_alliance_id, active_alliance_tag=None, avoid_territory=True, log_fn=None, logged_nodes=None, enemy_poi_coords=None, friendly_poi_coords=None, pass_obstacles=None, city_pos=None):
    if not avoid_territory:
        return True
    try:
        nid = node.get("node_id") or node.get("id") or 0
        tile_aid = normalize_rok_alliance_id(node.get("alliance_id", 0))
        tile_tag = clean_rok_tag(node.get("alliance_tag", ""))
        my_aid = normalize_rok_alliance_id(active_alliance_id)
        my_tag = clean_rok_tag(active_alliance_tag or "")
        dist = float(node.get("dist", 999.0))

        # 1. Proximity check to known enemy alliance structures / flags
        # Flag territory radius ~2.4km (14.4 wire units), Fortress ~3.8km (22.8 wire units)
        if enemy_poi_coords and isinstance(node.get("pos"), (list, tuple)) and len(node["pos"]) >= 2:
            nx, ny = float(node["pos"][0]), float(node["pos"][1])
            for item in enemy_poi_coords:
                if len(item) >= 4:
                    ex, ey, e_tag, radius_km = item[0], item[1], item[2], float(item[3])
                else:
                    ex, ey, e_tag = item[0], item[1], item[2]
                    radius_km = 2.4
                e_tag_clean = clean_rok_tag(e_tag) or str(e_tag)
                if not e_tag_clean or e_tag_clean in ("9223372036854775807", "18446744073709551615", "0", "-1"):
                    continue
                # Check both Euclidean distance and Chebyshev (square border) distance in wire units
                dx_wire = abs(nx - ex)
                dy_wire = abs(ny - ey)
                e_dist_km = math.hypot(dx_wire, dy_wire) / 6.0
                chebyshev_km = max(dx_wire, dy_wire) / 6.0
                if e_dist_km <= radius_km or chebyshev_km <= (radius_km * 0.85):
                    if log_fn and (logged_nodes is None or nid not in logged_nodes):
                        if logged_nodes is not None and nid:
                            logged_nodes.add(nid)
                        log_fn(f"[GATHER_FILTER] Node #{nid} rejected: inside enemy [{e_tag_clean}] territory ({e_dist_km:.1f}km <= {radius_km:.1f}km from enemy structure).")
                    return False

        # 2. Strict rival alliance tag rejection
        if tile_tag and (not my_tag or tile_tag.upper() != my_tag.upper()):
            if log_fn and (logged_nodes is None or nid not in logged_nodes):
                if logged_nodes is not None and nid:
                    logged_nodes.add(nid)
                log_fn(f"[GATHER_FILTER] Node #{nid} rejected: belongs to rival alliance [{tile_tag}].")
            return False

        # 3. Strict rival alliance ID rejection
        if tile_aid > 0 and (my_aid <= 0 or tile_aid != my_aid):
            if log_fn and (logged_nodes is None or nid not in logged_nodes):
                if logged_nodes is not None and nid:
                    logged_nodes.add(nid)
                log_fn(f"[GATHER_FILTER] Node #{nid} rejected: belongs to rival alliance ID #{tile_aid}.")
            return False

        # 4. Pass & Obstacle Traversal Check (Ensure marches never cross passes, gates, or barriers)
        if pass_obstacles and city_pos and isinstance(node.get("pos"), (list, tuple)) and len(node["pos"]) >= 2:
            is_blocked, block_reason = check_march_path_obstruction(
                city_pos=city_pos,
                node_pos=node["pos"],
                pass_obstacles=pass_obstacles,
                active_alliance_id=active_alliance_id,
                active_alliance_tag=active_alliance_tag,
            )
            if is_blocked:
                if log_fn and (logged_nodes is None or nid not in logged_nodes):
                    if logged_nodes is not None and nid:
                        logged_nodes.add(nid)
                    log_fn(f"[GATHER_FILTER] Node #{nid} skipped: {block_reason}")
                return False

        # 5. Friendly Territory (matching tag or matching alliance ID or near friendly flag)
        if my_tag and tile_tag and my_tag.upper() == tile_tag.upper():
            return True
        if my_aid > 0 and tile_aid > 0 and my_aid == tile_aid:
            return True
        if friendly_poi_coords and isinstance(node.get("pos"), (list, tuple)) and len(node["pos"]) >= 2:
            nx, ny = float(node["pos"][0]), float(node["pos"][1])
            for item in friendly_poi_coords:
                fx, fy = item[0], item[1]
                f_radius = float(item[3]) if len(item) >= 4 else 2.4
                if (math.hypot(nx - fx, ny - fy) / 6.0) <= f_radius:
                    return True

        # 6. Untagged / Neutral Land:
        # Strictly limit untagged neutral tiles to <= 40.0km safe perimeter
        if tile_aid == 0 and not tile_tag:
            if dist > 40.0:
                if log_fn and (logged_nodes is None or nid not in logged_nodes):
                    if logged_nodes is not None and nid:
                        logged_nodes.add(nid)
                    log_fn(f"[GATHER_FILTER] Node #{nid} skipped: {dist:.1f}km is beyond verified safe neutral perimeter (40.0km).")
                return False
            return True

        return False
    except Exception:
        return False

def extract_alliance_from_message(msg) -> Tuple[Optional[int], Optional[str], Optional[str]]:
    """Recursively discover alliance (alliance_id, alliance_name, alliance_tag) from decoded protobuf messages."""
    found_id = None
    found_name = None
    found_tag = None

    def _walk(obj):
        nonlocal found_id, found_name, found_tag
        if found_id and found_tag:
            return
        if isinstance(obj, dict):
            # Pattern A: Standard alliance info struct {1: id, 2: name, 3: tag}
            a_id = normalize_rok_alliance_id(obj.get(1))
            a_name = obj.get(2)
            a_tag = obj.get(3)
            if a_id > 0:
                name_str = a_name.decode("utf-8", "ignore") if isinstance(a_name, bytes) else str(a_name or "")
                tag_str = clean_rok_tag(a_tag)
                if tag_str and len(name_str) >= 1 and all(32 <= ord(c) < 127 or ord(c) > 160 for c in name_str):
                    found_id = a_id
                    found_name = name_str
                    found_tag = tag_str
                    return

            # Pattern B: Tag 19 of player profile in Opcode 1002
            t19 = obj.get(19)
            if isinstance(t19, bytes):
                tag_cand = clean_rok_tag(t19)
                if tag_cand and not found_tag:
                    found_tag = tag_cand

            for k, v in obj.items():
                if isinstance(v, bytes) and len(v) >= 4:
                    try:
                        sub = ProtobufCodec.decode_message(v)
                        _walk(sub)
                    except Exception:
                        pass
                elif isinstance(v, (dict, list)):
                    _walk(v)
        elif isinstance(obj, list):
            for item in obj:
                if isinstance(item, bytes) and len(item) >= 4:
                    try:
                        sub = ProtobufCodec.decode_message(item)
                        _walk(sub)
                    except Exception:
                        pass
                elif isinstance(item, (dict, list)):
                    _walk(item)

    _walk(msg)
    return found_id, found_name, found_tag

def parse_level_filter(level_str: str) -> Tuple[int, str]:
    s = (level_str or "").strip().lower()
    if "no cap" in s or "highest" in s or s in ("0", "any"):
        return 0, "any"
    if "6 and above" in s or "6+" in s:
        return 6, "min"
    if "6 and below" in s or "6-" in s or s == "6":
        return 6, "max"
    if "5 and below" in s or "5-" in s or s == "5":
        return 5, "max"
    if "4 and below" in s or "4-" in s or s == "4":
        return 4, "max"
    if "3 and below" in s or "3-" in s or s == "3":
        return 3, "max"
    if "2 and below" in s or "2-" in s or s == "2":
        return 2, "max"
    if "1" in s:
        return 1, "exact"
    return 6, "max"

