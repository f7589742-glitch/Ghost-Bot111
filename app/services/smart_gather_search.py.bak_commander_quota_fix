                                if insp_tag_clean and (not my_tag_clean or insp_tag_clean.upper() != my_tag_clean.upper()):
                                    print(f"[GATHER_FILTER] Live 1051 Inspect rejected Node #{target_node['node_id']}: belongs to rival alliance [{insp_tag_clean}]!")
                                    inspect_rejected_territory = True
                                elif insp_aid and int(insp_aid) > 0 and int(insp_aid) != int(f1_inspect) and (my_aid_int <= 0 or int(insp_aid) != my_aid_int):
                                    print(f"[GATHER_FILTER] Live 1051 Inspect rejected Node #{target_node['node_id']}: belongs to rival alliance ID #{insp_aid}!")
                                    inspect_rejected_territory = True
                    if got_1051:
                        break
                except asyncio.TimeoutError:
                    continue
                except Exception:
                    break
            if inspect_rejected_territory:
                failed_nodes_session.add(target_node["node_id"])
                error_node_flag = True
                break
            writer.write(FrameParser.build_frame(crypto_tx.encrypt(build_send_troop_confirm())))
            await writer.drain()
            await asyncio.sleep(0.05)
            pkt_1012 = build_gather_dispatch(
                target_node["node_id"],
                army_list=allocated_army,
                primary_hero_id=primary_cmd,
                secondary_hero_id=int(sec_cmd or 0),
                march_index=current_march_num
            )
            writer.write(FrameParser.build_frame(crypto_tx.encrypt(pkt_1012)))
            await writer.drain()
            confirmed = False
            error_135 = False
            error_155 = False
            error_node = False
            error_max_queues = False
            ack_code_last = None
            start_wait = time.time()
            while time.time() - start_wait < 3.5:
                try:
                    rh = await asyncio.wait_for(reader.readexactly(2), timeout=0.6)
                    rl = (rh[0] << 8) | rh[1]
                    raw_b = await asyncio.wait_for(reader.readexactly(rl), timeout=0.6)
                    dec = crypto_rx.decrypt(raw_b)
                    z_idx = dec.find(b"\x78\x9c")
                    if z_idx == -1: z_idx = dec.find(b"\x78\x01")
                    data = zlib.decompress(dec[z_idx:]) if z_idx != -1 else dec
                    m = ProtobufCodec.decode_message(data)
                    chunks = m.get(1) if isinstance(m.get(1), list) else [m]
                    for c in chunks:
                        item = ProtobufCodec.decode_message(c) if isinstance(c, bytes) else c
                        op = item.get(1)
                        if op is not None:
                            p_body = item.get(2)
                            p_dec = ProtobufCodec.decode_message(p_body) if isinstance(p_body, bytes) else p_body
                            print(f"      [GATEWAY ACK] Opcode: {op} | Payload: {p_dec}")
                            if op in (903, 365, 1013, 1023):
                                confirmed = True
                                ack_code_last = 0
                                break
                            if op == 1 and isinstance(p_dec, dict):
                                if p_dec.get(1) == 1012:
                                    code = p_dec.get(2, -1)
                                    ack_code_last = code
                                    if code in (0, 1):
                                        confirmed = True
                                        break
                                    elif code == 135:
                                        error_135 = True
                                        break
                                    elif code == 155:
                                        error_155 = True
                                        break
                                    elif code == 164:
                                        error_max_queues = True
                                        ack_code_last = 164
                                        break
                                    elif code in (30, 31, 102, 131, 134, 152, 156, 157, 158, 160, 161, 162):
                                        error_node = True
                                        break
                                    else:
                                        ack_code_last = code
                                        error_node = True
                                        break
                    if confirmed or error_135 or error_155 or error_node or error_max_queues:
                        break
                    if confirmed:
                        break
                except asyncio.TimeoutError:
                    continue
                except Exception:
                    break
            if confirmed:
                GatheringLoadEngine.deduct_troops(troops_in_city, selected_troops_dict)
                total_avail_soldiers = sum(troops_in_city.values())
                print(f"[SUCCESS] March #{current_march_num} CONFIRMED deployed with {cmd_display} on Node #{target_node['node_id']}!")
                busy_commanders.add(primary_cmd)
                failed_heroes_session.add(primary_cmd)
                if sec_cmd:
                    busy_commanders.add(sec_cmd)
                    failed_heroes_session.add(sec_cmd)
                active_marches[f"m_{primary_cmd}"] = primary_cmd
                dispatched_details.append({
                    "cmd_id": primary_cmd,
                    "sec_cmd_id": sec_cmd,
                    "cmd_name": cmd_display,
                    "type": target_node["type"],
                    "target": f"{target_node['name']} #{target_node['node_id']} (Lvl {target_node['level']})",
                    "troops": total_units,
                    "load": int(march_load),
                    "node_reserves": int(node_reserves)
                })
                # Ultra-detailed telemetry for dashboard (per spec: Sent gatherer to Stone level 4 (23,625 troops, cargo 472,500))
                try:
                    res_names_ar = {"food": "طعام", "wood": "خشب", "stone": "حجارة", "gold": "ذهب"}
                    res_type_str = str(target_node.get("type", "resource")).lower()
                    res_ar = res_names_ar.get(res_type_str, target_node.get("type", "Resource").capitalize())
                    res_badge = "🛡️ [نسخة احتياطية]" if is_backup_dispatch else "🌾 [جمع الموارد]"
                    dash_gather_msg = (
                        f"{res_badge} تم إرسال {cmd_display} إلى حقل {res_ar} "
                        f"لفل {target_node['level']} ({total_units:,} جندي، حمولة {int(march_load):,})"
                    )
                    print(f"[DASHBOARD] [{char_name}] {dash_gather_msg}")
                    try:
                        from app.services.activity_logger import TenantActivityStream
                        target_bot_id = str(kwargs.get("bot_id") or "bot-2404")
                        TenantActivityStream.emit(target_bot_id, char_name, dash_gather_msg, user_id=tenant_id or None)
                    except Exception as e_act:
                        print(f"[-] TenantActivityStream gather emit error: {e_act}")

                    try:
                        from app.models import TaskLogDAO, CharacterDAO
                        db_c = CharacterDAO.get_by_role_id(str(active_role_id))
                        TaskLogDAO.create(
                            task_id=f"gather_{active_role_id}_{current_march_num}_{int(time.time())}",
                            role_id=str(active_role_id),
                            task_type="gather_dispatch",
                            status="SUCCESS",
                            details={
                                "message": dash_gather_msg,
                                "character_name": char_name,
                                "commander": cmd_display,
                                "resource": target_node["type"],
                                "level": target_node["level"],
                                "units": total_units,
                                "cargo": int(march_load),
                                "node_reserves": int(node_reserves),
                                "node_id": target_node["node_id"]
                            },
                            character_id=int(db_c["id"]) if db_c and db_c.get("id") else None
                        )
                    except Exception as e_log:
                        print(f"[-] TaskLogDAO gather write error: {e_log}")
                    try:
                        from app.services.activity_stream import activity_stream
                        import asyncio as _asyncio2
                        _asyncio2.create_task(activity_stream.broadcast(f"[{char_name}] {dash_gather_msg}", user_id=tenant_id or ""))
                    except Exception:
                        pass
                except Exception as e_tele:
                    print(f"[-] gather telemetry error: {e_tele}")
                dispatched += 1
                dispatched_count += 1
                queue_confirmed = True
                await asyncio.sleep(1.4) # Rate-limit: 1.4s sleep between dispatch packets
                break
            elif error_max_queues:
                print(f"[ENGINE] Maximum march queues reached for this character (code 164). All available queues deployed!")
                break
            elif error_135:
                if sec_cmd:
                    print(f"[-] Dual-commander {cmd_display} rejected (Error 135). Blacklisting secondary #{sec_cmd} so primary #{primary_cmd} retries SOLO...")
                    failed_heroes_session.add(sec_cmd)
                else:
                    print(f"[-] Commander {cmd_display} rejected (Error 135: hero busy/garrisoned). Blacklisting hero and retrying SAME node with next candidate...")
                    failed_heroes_session.add(primary_cmd)
                await asyncio.sleep(0.3)
                continue
            elif error_155:
                if sec_cmd:
                    print(f"[-] Dual-commander {cmd_display} rejected (Error 155). Blacklisting secondary #{sec_cmd} so primary #{primary_cmd} retries SOLO on SAME node...")
                    failed_heroes_session.add(sec_cmd)
                elif cmd_155_rejections.get(primary_cmd, 0) == 0 and total_units > 32000:
                    print(f"[-] Commander {cmd_display} rejected with {total_units:,} troops (Error 155: troop capacity overflow). Retrying {primary_name} SOLO with capped 32,000 troop stack...")
                    cmd_155_rejections[primary_cmd] = 1
                    cand_queue.insert(0, (pri_info, None))
                else:
                    print(f"[-] Commander {cmd_display} rejected (Error 155: unavailable/overflow). Retrying SAME node with next candidate...")
                    failed_heroes_session.add(primary_cmd)
                await asyncio.sleep(0.3)
                continue
            elif error_node:
                code_str = ack_code_last if ack_code_last is not None else "node"
                print(f"[-] Node #{target_node['node_id']} rejected (Error {code_str}: unreachable/fog/occupied). Blacklisting node and keeping commander {cmd_display}...")
                failed_nodes_session.add(target_node["node_id"])
                error_node_flag = True
                break
            else:
                print(f"[-] Commander {cmd_display} dispatch not confirmed (code={ack_code_last}). Retrying SAME node with next candidate...")
                failed_heroes_session.add(primary_cmd)
                if sec_cmd:
                    failed_heroes_session.add(sec_cmd)
                await asyncio.sleep(0.4)
                continue
        if error_max_queues:
            stop_reason = "server_queue_limit"
            print(f"[ENGINE] Halting dispatch loop — governor capacity reached.")
            break
        if not queue_confirmed:
            if error_155_flag or error_node_flag:
                continue
            if candidate_allocations and target_node["node_id"] not in failed_nodes_session:
                print(f"[ENGINE] All commander candidates rejected on Node #{target_node['node_id']}. Blacklisting node and retrying queue.")
                failed_nodes_session.add(target_node["node_id"])
                continue


    print("\n" + "=" * 65)
    print(f"  [SUMMARY] Dispatched {dispatched} new march(es) | Active Marches: {len(active_marches)}/{account_max_queues}")
    print(f"  Available City Army: {total_avail_soldiers:,} soldiers remaining")
    print("=" * 65)

    save_gather_status(active_marches, total_avail_soldiers, dispatched_details)
    try:
        writer.close()
        await writer.wait_closed()
    except Exception:
        pass
    return {
        "success": (dispatched > 0 or len(active_marches) > 0),
        "dispatched_count": dispatched,
        "active_marches_count": len(active_marches),
        "max_marches": account_max_queues,
        "free_queues": free_queues,
        "reason": stop_reason,
        "filtered_nodes": {"territory": len(logged_rejected_territory), "partial": len(logged_skipped_partial), "level": len(logged_skipped_level)},
        "dispatched_details": dispatched_details,
        "max_allowed_level": max_allowed_level,
        "free_nodes_discovered": len(free_nodes),
    }

