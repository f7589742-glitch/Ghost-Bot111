    def _ensure_accounts_bound(self):
        """Dynamic account-to-bot fallback: if no accounts are found for (user_id, bot_id),
        automatically rebind any existing accounts owned by this user or bot to guarantee the pipeline runs."""
        try:
            from app.database import get_db_connection
            from app.models import AccountDAO, CharacterDAO
            con = get_db_connection()
            uid = str(self._user_id or "").strip()
            bid = str(self._bot_id or "bot-2404").strip()

            # 1. Check if accounts already match (uid, bid)
            accounts = AccountDAO.get_all(uid or None, bot_id=bid)
            non_shoob = [a for a in accounts if "shoob" not in str(a.get("email") or "").lower()]
            if non_shoob:
                return

            with con:
                # 2. Check if accounts exist for this bot_id under any user_id
                bids = [bid]
                if bid.startswith("bot-"):
                    bids.append(bid[4:])
                else:
                    bids.append(f"bot-{bid}")
                placeholders = ",".join("?" for _ in bids)
                bot_rows = con.execute(
                    f"SELECT id, user_id FROM accounts WHERE bot_id IN ({placeholders}) AND LOWER(email) NOT LIKE '%shoob%'",
                    tuple(bids)
                ).fetchall()

                if bot_rows:
                    if uid:
                        con.execute(
                            f"UPDATE accounts SET user_id = ?, is_active = 1 WHERE bot_id IN ({placeholders}) AND LOWER(email) NOT LIKE '%shoob%'",
                            (uid, *bids)
                        )
                    con.execute(
                        f"UPDATE characters SET enabled = 1 WHERE account_id IN (SELECT id FROM accounts WHERE bot_id IN ({placeholders})) AND LOWER(name) NOT LIKE '%shoob%'",
                        tuple(bids)
                    )
                    return

                # 3. Check if user has accounts under another bot_id or NULL
                if uid:
                    user_rows = con.execute(
                        "SELECT id FROM accounts WHERE user_id = ? AND LOWER(email) NOT LIKE '%shoob%'",
                        (uid,)
                    ).fetchall()
                    if user_rows:
                        con.execute(
                            "UPDATE accounts SET bot_id = ?, is_active = 1 WHERE user_id = ? AND LOWER(email) NOT LIKE '%shoob%'",
                            (bid, uid)
                        )
                        con.execute(
                            "UPDATE characters SET enabled = 1 WHERE account_id IN (SELECT id FROM accounts WHERE user_id = ?) AND LOWER(name) NOT LIKE '%shoob%'",
                            (uid,)
                        )
                        return

                # 4. Global fallback removed — do not bind other tenants' accounts
                logger.warning(f"[_ensure_accounts_bound] No accounts found for uid={uid} bot_id={bid}. User must link an account first.")

        except Exception as e_bind:
            logger.warning(f"Error in _ensure_accounts_bound for {self._bot_id}: {e_bind}")

    async def execute_staged_sweep(self, account_tasks_data: list):
        """
        Strict Two-Stage Staged Execution across ALL linked accounts:
          Stage 1 (Primary / Slot 1): Iterate through ALL Slot 1 governors across ALL linked accounts sequentially,
                                      with randomized 5-10s stagger delay between each account.
          Stage 2 (Secondary / Slot 2): After Stage 1 completely finishes, iterate through ALL Slot 2 governors across
                                        ALL linked accounts sequentially, with the same 5-10s stagger delay.
        """
        uid = self._user_id or ""
        lang = BotSettingsDAO.get("ui_language", "ar", user_id=uid or None).lower()
        is_ar = "ar" in lang or not ("en" in lang)

        if not account_tasks_data:
            warn_msg = (
                "⚠️ [تنبيه] لا توجد حسابات أو شخصيات مفعلة لهذه الوحدة. يرجى ربط حساب وتفعيل الشخصيات أولاً."
                if is_ar
                else "⚠️ [WARNING] No enabled accounts or governors found for this unit. Please link an account and enable governors."
            )
            TenantActivityStream.emit(self._bot_id, None, warn_msg, user_id=uid)
            await activity_stream.broadcast(warn_msg, user_id=uid)
            logger.warning(warn_msg)
            return

        if self._lock.locked():
            logger.info(f"[{self._bot_id}] Staged sweep already in progress. Skipping redundant concurrent trigger.")
            return

        async with self._lock:
            # Step 1: Separate into Slot 1 (Primary) and Slot 2 (Secondary)
            slot1_characters = []
            slot2_characters = []

            for acc, chars in account_tasks_data:
                # Sort characters deterministically by database ID so Slot 1 is always the primary governor
                sorted_chars = sorted(chars, key=lambda c: (int(c.get("id") or 0), str(c.get("role_id") or "")))
                if len(sorted_chars) > 0:
                    slot1_characters.append((acc, sorted_chars[0]))
                if len(sorted_chars) > 1:
                    for sec_c in sorted_chars[1:]:
                        slot2_characters.append((acc, sec_c))

            total_slot1 = len(slot1_characters)
            total_slot2 = len(slot2_characters)

            if total_slot1 == 0 and total_slot2 == 0:
                warn_msg = (
                    "⚠️ [تنبيه] لا توجد حسابات أو شخصيات مفعلة لهذه الوحدة. يرجى ربط حساب وتفعيل الشخصيات أولاً."
                    if is_ar
                    else "⚠️ [WARNING] No enabled accounts or governors found for this unit. Please link an account and enable governors."
                )
                TenantActivityStream.emit(self._bot_id, None, warn_msg, user_id=uid)
                await activity_stream.broadcast(warn_msg, user_id=uid)
                logger.warning(warn_msg)
                return

            # ================= STAGE 1: ALL PRIMARY GOVERNORS (SLOT 1) CONCURRENTLY =================
            # ================= STAGE 1: ALL PRIMARY GOVERNORS (SLOT 1) SEQUENTIALLY =================
            stage1_banner = (
                f"🚀 [المرحلة 1] تشغيل الحكام الأساسيين (الخانة 1) تتابعياً عبر {total_slot1} حساب مع فاصل 5-10 ثوانٍ..."
                if is_ar
                else f"🚀 [STAGE 1] Running Primary Governors (Slot 1) sequentially across {total_slot1} accounts (5-10s delay)..."
            )
            logger.info(stage1_banner)
            print(stage1_banner, flush=True)
            TenantActivityStream.emit(self._bot_id, None, stage1_banner, user_id=uid)
            await activity_stream.broadcast(stage1_banner, user_id=uid)

            async def _run_single_governor(acc, char, stage_num, slot_num, idx, total):
                if not self._running or not BotSettingsDAO.is_bot_running(self._bot_id, uid):
                    return
                cname = char.get("name") or char.get("role_id")
                acc_email = acc.get("email") or f"Account #{acc.get('id')}"
                step_msg = (
                    f"⚡ [المرحلة {stage_num} - الخانة {slot_num} ({idx}/{total})] بدء فحص وتشغيل الحاكم {cname} على {acc_email}..."
                    if is_ar
                    else f"⚡ [STAGE {stage_num} - Slot {slot_num} ({idx}/{total})] Visiting governor {cname} on {acc_email}..."
                )
                logger.info(step_msg)
                print(step_msg, flush=True)
                TenantActivityStream.emit(self._bot_id, cname, step_msg, user_id=uid)
                await activity_stream.broadcast(step_msg, user_id=uid)

                try:
                    await self._run_account_pipeline(acc, [char], force_run=True, already_locked=False)
                except Exception as e_run:
                    logger.error(f"[STAGE {stage_num}] Error during visit for {cname}: {e_run}", exc_info=True)

            for idx, (acc, char) in enumerate(slot1_characters, 1):
                if not self._running or not BotSettingsDAO.is_bot_running(self._bot_id, uid):
                    break
                await _run_single_governor(acc, char, 1, 1, idx, total_slot1)
                if idx < total_slot1 and self._running and BotSettingsDAO.is_bot_running(self._bot_id, uid):
                    delay_s = random.uniform(5.0, 10.0)
                    logger.info(f"[STAGE 1] Stagger delay {delay_s:.1f}s before next primary governor...")
                    await asyncio.sleep(delay_s)

            if not self._running or not BotSettingsDAO.is_bot_running(self._bot_id, uid):
                halt_msg = "🛑 [النظام] تم إيقاف تشغيل الوحدة فوراً بأمر المستخدم." if is_ar else "🛑 [SYSTEM] Unit execution halted immediately by user command."
                logger.info("[SCHEDULER] Two-stage sweep stopped before Stage 2.")
                TenantActivityStream.emit(self._bot_id, None, halt_msg, user_id=uid)
                await activity_stream.broadcast(halt_msg, user_id=uid)
                return

            stage1_done_msg = (
                f"✅ [اكتملت المرحلة 1] تم الانتهاء من جميع الحكام الأساسيين ({total_slot1} حساب)."
                if is_ar
                else f"✅ [STAGE 1 COMPLETE] All {total_slot1} Primary Governors finished."
            )
            logger.info(stage1_done_msg)
            print(stage1_done_msg, flush=True)
            TenantActivityStream.emit(self._bot_id, None, stage1_done_msg, user_id=uid)
            await activity_stream.broadcast(stage1_done_msg, user_id=uid)

            # Brief settle delay between Stage 1 and Stage 2
            await asyncio.sleep(random.uniform(3.0, 5.0))

            # ================= STAGE 2: ALL SECONDARY GOVERNORS (SLOT 2) SEQUENTIALLY =================
            if total_slot2 > 0 and self._running and BotSettingsDAO.is_bot_running(self._bot_id, uid):
                stage2_banner = (
                    f"🚀 [المرحلة 2] تشغيل الحكام الثانويين (الخانة 2) تتابعياً عبر {total_slot2} حساب مع فاصل 5-10 ثوانٍ..."
                    if is_ar
                    else f"🚀 [STAGE 2] Running Secondary Governors (Slot 2) sequentially across {total_slot2} accounts (5-10s delay)..."
                )
                logger.info(stage2_banner)
                print(stage2_banner, flush=True)
                TenantActivityStream.emit(self._bot_id, None, stage2_banner, user_id=uid)
                await activity_stream.broadcast(stage2_banner, user_id=uid)

                for idx, (acc, char) in enumerate(slot2_characters, 1):
                    if not self._running or not BotSettingsDAO.is_bot_running(self._bot_id, uid):
                        break
                    await _run_single_governor(acc, char, 2, 2, idx, total_slot2)
                    if idx < total_slot2 and self._running and BotSettingsDAO.is_bot_running(self._bot_id, uid):
                        delay_s = random.uniform(5.0, 10.0)
                        logger.info(f"[STAGE 2] Stagger delay {delay_s:.1f}s before next secondary governor...")
                        await asyncio.sleep(delay_s)

                if not self._running or not BotSettingsDAO.is_bot_running(self._bot_id, uid):
                    halt_msg = "🛑 [النظام] تم إيقاف تشغيل الوحدة فوراً بأمر المستخدم." if is_ar else "🛑 [SYSTEM] Unit execution halted immediately by user command."
                    TenantActivityStream.emit(self._bot_id, None, halt_msg, user_id=uid)
                    await activity_stream.broadcast(halt_msg, user_id=uid)
                    return

                stage2_done_msg = (
                    f"✅ [اكتملت المرحلة 2] تم الانتهاء من جميع الحكام الثانويين ({total_slot2} حساب)."
                    if is_ar
                    else f"✅ [STAGE 2 COMPLETE] All {total_slot2} Secondary Governors finished."
                )
                logger.info(stage2_done_msg)
                print(stage2_done_msg, flush=True)
                TenantActivityStream.emit(self._bot_id, None, stage2_done_msg, user_id=uid)
                await activity_stream.broadcast(stage2_done_msg, user_id=uid)

            # Post-cycle completion & next run timestamp calculation
            now_str = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            interval_hours = self._parse_interval_hours()
            next_run_str = self._calculate_next_run(interval_hours)
            
            BotSettingsDAO.set("next_run_timestamp", next_run_str, user_id=uid or None)
            if self._bot_id:
                BotSettingsDAO.set(f"next_run_timestamp_{self._bot_id}", next_run_str, user_id=uid or None)

            for acc, chars in account_tasks_data:
                AccountDAO.update_run_times(acc["id"], last_run=now_str, next_run=next_run_str)
                for c in chars:
                    CharacterDAO.update_run_times(c.get("role_id"), last_run=now_str, next_run=next_run_str)

            sweep_done_msg = (
                f"⚡ [اكتملت دورة الأسطول] تم إنهاء فحص وتشغيل جميع الحكام بنجاح عبر المرحلتين. الدورة القادمة: {next_run_str}"
                if is_ar
                else f"⚡ [FLEET SWEEP COMPLETE] All two-stage governor cycles finished successfully. Next cycle: {next_run_str}"
            )
            logger.info(sweep_done_msg)
            print(sweep_done_msg, flush=True)
            TenantActivityStream.emit(self._bot_id, None, sweep_done_msg, user_id=uid)
            await activity_stream.broadcast(sweep_done_msg, user_id=uid)

    async def _run_loop(self):
        logger.info(f"AutonomousScheduler loop entered for tenant {self._user_id} bot_id={self._bot_id}.")
        while self._running:
            try:
                # 1. Dynamic account-to-bot fallback alignment
                self._ensure_accounts_bound()

                if self._bot_id:
                    accounts = AccountDAO.get_all(self._user_id, bot_id=self._bot_id)
                else:
                    accounts = AccountDAO.get_all(self._user_id)
                active_accounts = [
                    a for a in accounts
                    if a.get("is_active", 1) == 1
                    and "shoob" not in str(a.get("email") or "").lower()
                ]
                
                account_tasks_data = []
                for acc in active_accounts:
                    chars = CharacterDAO.get_by_account_id(acc["id"])
                    enabled_chars = [
                        c for c in chars
                        if c.get("enabled", 1) == 1
                        and int(c.get("kingdom_id") or 0) not in (3150, 3173)
                        and "shoob" not in str(c.get("name") or "").lower()
                    ]
                    if not enabled_chars and chars:
                        valid_chars = [c for c in chars if int(c.get("kingdom_id") or 0) not in (3150, 3173) and "shoob" not in str(c.get("name") or "").lower()]
                        if valid_chars:
                            from app.database import get_db_connection
                            with get_db_connection() as con:
                                con.execute("UPDATE characters SET enabled = 1 WHERE account_id = ? AND LOWER(name) NOT LIKE '%shoob%'", (acc["id"],))
                            enabled_chars = valid_chars
                    if enabled_chars:
                        account_tasks_data.append((acc, enabled_chars))

                if not account_tasks_data:
                    lang = BotSettingsDAO.get("ui_language", "ar", user_id=self._user_id or None).lower()
                    is_ar = "ar" in lang or not ("en" in lang)
                    warn_msg = (
                        "⚠️ [تنبيه] لا توجد حسابات أو شخصيات مفعلة لهذه الوحدة. يرجى ربط حساب وتفعيل الشخصيات أولاً."
                        if is_ar
                        else "⚠️ [WARNING] No enabled accounts or governors found for this unit. Please link an account and enable governors."
                    )
                    logger.warning(f"[{self._bot_id}] {warn_msg}")
                    TenantActivityStream.emit(self._bot_id, None, warn_msg, user_id=self._user_id)
                    await activity_stream.broadcast(warn_msg, user_id=self._user_id)
                else:
                    logger.info(
                        f"Fleet two-stage execution [{self._bot_id}]: processing {len(account_tasks_data)} account(s) (Slot 1 Primary -> Slot 2 Secondary)..."
                    )
                    await self.execute_staged_sweep(account_tasks_data)
                    logger.info("All staged character pipelines completed.")

                interval_hours = self._parse_interval_hours()
                sleep_seconds = max(30, int(interval_hours * 3600))
                logger.info(f"Sweep complete. Sleeping for {sleep_seconds}s before next round.")
                elapsed = 0
                while self._running and elapsed < sleep_seconds:
                    step = min(5.0, sleep_seconds - elapsed)
                    try:
                        await asyncio.wait_for(self._wake_event.wait(), timeout=step)
                        self._wake_event.clear()
                        logger.info(f"AutonomousScheduler [{self._bot_id}] awakened by trigger.")
                        break
                    except asyncio.TimeoutError:
                        elapsed += step
            except asyncio.CancelledError:
                break
            except Exception as e:
                logger.error(f"Error in AutonomousScheduler loop: {e}", exc_info=True)
                await asyncio.sleep(30.0)


