    Retries login with the captchaId UUID issued by the CaptchaDialog bridge
    after the user solves the slider at captcha-global.lilithgame.com.
    """
    email = req.email.strip().lower()
    password = req.password
    user_id = (getattr(req, "user_id", "") or "").strip()
    if not user_id:
        raise HTTPException(status_code=401, detail="Tenant user_id required")

