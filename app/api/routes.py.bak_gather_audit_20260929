}

def _seed_character_settings(char_id: int, user_id: str) -> None:
    """Seed automation settings for a freshly synced character.

    Never clobbers existing user configuration: creates a settings row
    only when missing, and fills the gather block only when empty —
    from the tenant's website gather config (or defaults). This is what
    makes every newly added website account immediately runnable by the
    AutonomousScheduler (which re-reads active accounts every sweep).
    """
    try:
        from app.database import get_db_connection
        con = get_db_connection()
        row = con.execute(
            "SELECT gather_json FROM character_settings WHERE character_id = ?",
            (char_id,)).fetchone()
    except Exception:
        return
    try:
        tenant_gather = {}
        raw = BotSettingsDAO.get("gather_config", user_id=user_id)
        if raw:
            parsed = json.loads(raw)
            if isinstance(parsed, dict):
                tenant_gather = parsed
    except Exception:
        tenant_gather = {}
    seed = dict(_DEFAULT_GATHER_SEED)
    seed.update(tenant_gather or {})
    try:
        if not row:
            CharacterSettingsDAO.upsert(char_id, train_pct=100, gather=seed)
            return
        try:
            existing = json.loads(row["gather_json"] or "{}")
        except Exception:
            existing = {}
        if not existing:
            CharacterSettingsDAO.upsert(char_id, gather=seed)
    except Exception:
        pass

@router.get("/dashboard/stats", response_model=DashboardStatsResponse)
def get_dashboard_stats(user_id: str = Query(...)):
    """Retrieve this tenant's fleet summary only."""
    accounts = AccountDAO.get_all(user_id)
    characters = CharacterDAO.get_all(user_id=user_id)
    total_power = sum(c.get("power", 0) for c in characters)
    
    logs = TaskLogDAO.get_recent(limit=500, user_id=user_id)
    completed = sum(1 for l in logs if l.get("status") == "SUCCESS")
    failed = sum(1 for l in logs if l.get("status") == "FAILED")

    return DashboardStatsResponse(
        total_accounts=len(accounts),
        total_characters=len(characters),
        total_power=total_power,
        total_tasks_completed=completed,
        total_tasks_failed=failed
    )

@router.post("/accounts/sync")
def sync_account(req: AccountSyncRequest):
    """
    Authenticate directly with Lilith Cloud Passport.
    If captcha challenge (Geetest) is triggered, relays challenge parameters to browser.
    """
    email = req.email.strip().lower()
    password = req.password
    user_id = (getattr(req, "user_id", "") or "").strip()
    if not user_id:
        raise HTTPException(status_code=401, detail="Tenant user_id required")

    existing_acc = AccountDAO.get_by_email(email, user_id)
    device_profile = None

    if existing_acc:
        device_profile = existing_acc.get("device_profile")
        if existing_acc.get("app_token"):
            app_uid = existing_acc.get("app_uid")
            app_token = existing_acc.get("app_token")
            udid = existing_acc.get("udid")
            account_id = existing_acc.get("id")
            logger.info(f"Using cached token for {email} (UID: {app_uid})")

            # Guard 1: genuine Lilith app_tokens always start with "A-".
            # A corrupt cached value must never produce a fake "0 characters" success.
            if app_token and str(app_token).startswith("A-"):
                req_bot_id = getattr(req, "bot_id", None)
                if req_bot_id:
                    try:
                        from app.database import get_db_connection
                        con = get_db_connection()
                        with con:
                            con.execute("UPDATE accounts SET bot_id = ? WHERE id = ? AND user_id = ?", (req_bot_id, account_id, user_id))
                    except Exception:
                        pass
                # Sync fresh characters from rocdir
                raw_characters = LilithCloudService.get_roles(app_uid, app_token, udid)
                if raw_characters:
                    synced_characters = []
                    for rc in raw_characters:
                        c_obj = CharacterDAO.upsert(
                            account_id=account_id,
                            role_id=str(rc["role_id"]),
                            name=rc["name"],
                            kingdom_id=int(rc["kingdom_id"]),
                            power=int(rc.get("power", 0)),
                            city_level=int(rc.get("city_level", 1)),
                            avatar_url=rc.get("avatar_url", ""),
                            alliance_tag=rc.get("alliance_tag", ""),
                            is_active_cloud=False
                        )
                        synced_characters.append(c_obj)
                        _seed_character_settings(int(c_obj["id"]), user_id)

                    return {
                        "success": True,
                        "status": "AUTHENTICATED",
                        "message": f"Successfully synced {len(synced_characters)} characters for {email}",
                        "account": {
                            "id": account_id,
                            "email": email,
                            "app_uid": app_uid,
                            "characters_found": len(synced_characters)
                        },
                        "characters": synced_characters
                    }
                logger.warning(f"Cached token for {email} returned 0 roles (stale/invalid). Falling through to fresh authentication.")
            else:
                logger.warning(f"Cached token for {email} has invalid format. Forcing fresh authentication.")

    if not device_profile:
        device_profile = DeviceGenerator.generate(email)
    device_profile = DeviceGenerator.ensure_sdk_fields(device_profile, email)
    if existing_acc:
        # Persist backfilled SDK identity fields so install_id etc. stay stable.
        try:
            AccountDAO.update_device_profile(email, user_id, device_profile)
        except Exception:
            pass

    # Like the official client, carry any previous session along with the login.
    prev_uid = existing_acc.get("app_uid") if existing_acc else None
    prev_token = existing_acc.get("app_token") if existing_acc else None
    auth_res = LilithCloudService.authenticate(
        email, password, device_profile=device_profile,
        app_uid=prev_uid, app_token=prev_token,
    )

    # 1. Challenge / Captcha handling
    if auth_res.get("status") == "REQUIRES_VERIFICATION":
        return {
            "success": False,
            "status": "REQUIRES_VERIFICATION",
            "captcha_type": auth_res.get("captcha_type", "geetest"),
            "gt": auth_res.get("gt"),
            "challenge": auth_res.get("challenge"),
            "captcha_url": auth_res.get("captcha_url", ""),
            "email": email
        }

    # 2. Authentication failure
    if not auth_res.get("success"):
        raise HTTPException(
            status_code=400,
            detail=auth_res.get("error", "Lilith Cloud Authentication Failed.")
        )

    # 3. Successful login
    app_uid = str(auth_res["app_uid"])
    app_token = auth_res["app_token"]
    udid = auth_res["udid"]
    expires_at = auth_res.get("token_expires_at")

    enc_pw = encrypt_password(password)
    req_bot_id = getattr(req, "bot_id", None)
    try:
        acc_obj = AccountDAO.upsert(
            email=email,
            user_id=user_id,
            encrypted_password=enc_pw,
            udid=udid,
            app_uid=app_uid,
            app_token=app_token,
            token_expires_at=expires_at,
            device_profile=device_profile,
            bot_id=req_bot_id
        )
    except PermissionError as e:
        raise HTTPException(status_code=403, detail=str(e))
    account_id = acc_obj["id"]

    raw_characters = LilithCloudService.get_roles(app_uid, app_token, udid)
    synced_characters = []
    for rc in raw_characters:
        c_obj = CharacterDAO.upsert(
            account_id=account_id,
            role_id=str(rc["role_id"]),
            name=rc["name"],
            kingdom_id=int(rc["kingdom_id"]),
            power=int(rc.get("power", 0)),
            city_level=int(rc.get("city_level", 1)),
            avatar_url=rc.get("avatar_url", ""),
            alliance_tag=rc.get("alliance_tag", ""),
            is_active_cloud=False
        )
        synced_characters.append(c_obj)
        _seed_character_settings(int(c_obj["id"]), user_id)

    return {
        "success": True,
        "status": "AUTHENTICATED",
        "message": f"Successfully authenticated {email} and synced {len(synced_characters)} characters!",
        "account": {
            "id": account_id,
            "email": email,
            "app_uid": app_uid,
            "characters_found": len(synced_characters)
        },
        "characters": synced_characters
    }

@router.post("/accounts/verify-captcha")
def verify_captcha(req: CaptchaVerifyRequest):
