        if training_dict and cat in training_dict:
            if not training_dict.get(cat):
                continue
            categories.append(cat)
        elif tier_val is not None and str(tier_val).lower() not in ("off", "skip", "0", ""):
            categories.append(cat)
        elif not tiers:
            categories.append(cat)
    if not categories:
        categories = ["infantry","cavalry","archery","siege"]
    task_id = f"task_{uuid.uuid4().hex[:12]}"
    TaskLogDAO.create(task_id=task_id, role_id=role_id, task_type="train", status="RUNNING", details={"params": {"categories": categories, "tiers": tiers}}, character_id=char["id"])
    bg_tasks.add_task(
