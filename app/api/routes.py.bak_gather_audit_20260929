@router.get("/bot/{bot_id}/inventory")
def bot_inventory(bot_id: str, request: Request, group_by: Optional[str] = Query(None), user_id: Optional[str] = Query(None)):
    """Real-time inventory for ONE bot unit.

    Returns gathered sums (today / 7d / 30d with per-day trend), the live
    in-cities-now totals, and the per-character breakdown. Every query is
    filtered by bot_id / user_id — zero cross-unit leakage.
    """
    from app.models import InventoryDAO, RunHistoryDAO
    bid = bot_id.strip()
    req_uid = request.headers.get("x-user-id", "").strip() or (user_id or "").strip()
    uid = _resolve_tenant_uid(req_uid, bid, request)
    if not uid:
        return {
            "bot_id": bid,
            "resources_gathered": {},
            "in_cities_now": {"food": 0, "wood": 0, "stone": 0, "gold": 0, "gems": 0},
            "characters": [],
            "characters_by_kingdom": None,
        }

    characters = InventoryDAO.list_for_bot(bid, user_id=uid)
    in_cities = {
        "food": sum(int(c.get("food") or 0) for c in characters),
        "wood": sum(int(c.get("wood") or 0) for c in characters),
        "stone": sum(int(c.get("stone") or 0) for c in characters),
        "gold": sum(int(c.get("gold") or 0) for c in characters),
        "gems": sum(int(c.get("gems") or 0) for c in characters),
    }

    windows = {}
    for label, days in (("today", 1), ("7days", 7), ("30days", 30)):
        agg = RunHistoryDAO.aggregated_gathered(bid, days, user_id=uid)
        windows[label] = {**agg, "trend": RunHistoryDAO.daily_trend(bid, days, user_id=uid)}

    chars_out = [
        {
            "governor_id": str(c.get("role_id") or ""),
            "name": c.get("name") or "",
            "kingdom": int(c.get("kingdom_id") or 0),
            "city_hall": int(c.get("city_hall_level") or 0),
            "power": int(c.get("power") or 0),
            "food": int(c.get("food") or 0),
            "wood": int(c.get("wood") or 0),
            "stone": int(c.get("stone") or 0),
            "gold": int(c.get("gold") or 0),
            "gems": int(c.get("gems") or 0),
            "total": int(c.get("food") or 0) + int(c.get("wood") or 0)
                     + int(c.get("stone") or 0) + int(c.get("gold") or 0),
        }
        for c in characters
    ]

    grouped = None
    if (group_by or "").lower() == "kingdom":
        grouped = {}
        for c in chars_out:
            grouped.setdefault(str(c["kingdom"]), []).append(c)
    return {
        "bot_id": bid,
        "resources_gathered": windows,
        "in_cities_now": in_cities,
        "characters": chars_out,
        "characters_by_kingdom": grouped,
    }

