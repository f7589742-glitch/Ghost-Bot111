@router.delete("/accounts/{account_id}")
def delete_account(
    account_id: str,
    request: Request,
    user_id: Optional[str] = Query(None),
    email: Optional[str] = Query(None)
):
    """Permanently remove an account and all its associated characters and settings.
    Accepts integer ID OR email address as account_id, with optional query user_id/email."""
    req_uid = request.headers.get("x-user-id", "").strip() or (user_id or "").strip()
    uid = req_uid if req_uid else None
    target = str(email or account_id).strip()
    
    deleted = AccountDAO.delete(target, uid)
    if not deleted and uid:
        # Failsafe fallback across tenants if ID was orphaned or tenant switched
        deleted = AccountDAO.delete(target, None)
    
    if not deleted and account_id and account_id != target:
        deleted = AccountDAO.delete(account_id, uid) or AccountDAO.delete(account_id, None)

    if not deleted:
        # If not found, return 200 with already deleted state so UI doesn't crash on stale client references
        return {"success": True, "message": f"Account {target} already removed", "account_id": target, "already_deleted": True}

    return {"success": True, "message": f"Account {target} deleted successfully", "account_id": target}


