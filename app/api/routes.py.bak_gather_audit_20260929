    """
    Hierarchical Configuration Scoping Engine:
    - Scope 'role' or role_id present: updates only that specific character row.
    - Scope 'email' or email present: updates only characters owned by that specific email account.
    - Scope 'all' / global: updates all character rows owned by this user_id.
    """
    scope = payload.get("scope", "all")
    email = payload.get("email")
    role_id = payload.get("role_id")
    config = payload.get("config") or payload.get("settings") or payload
    combat_input = config.get("combat") if isinstance(config.get("combat"), dict) else {}
    mirror_combat = (config.get("mirror") or {}).get("combat", {}) if isinstance(config.get("mirror"), dict) else {}

    barbs_val = config.get("barbs")
    if barbs_val is None:
        barbs_val = combat_input.get("barbs")
    if barbs_val is None:
        barbs_val = mirror_combat.get("barbs")

    highest_barb_level_val = config.get("highestBarbLevel") or config.get("highest_barb_level") or combat_input.get("highest_barb_level") or mirror_combat.get("highest_barb_level")
    skip_barbs_below_val = config.get("skipBarbsBelow") or config.get("skip_barbs_below") or combat_input.get("skip_barbs_below") or mirror_combat.get("skip_barbs_below")
    primary_cmd_val = config.get("barbPrimaryCommander") or config.get("primary_commander") or combat_input.get("primary_commander") or mirror_combat.get("primary_commander")
    secondary_cmd_val = config.get("barbSecondaryCommander") or config.get("secondary_commander") or combat_input.get("secondary_commander") or mirror_combat.get("secondary_commander")
    combat_rounds_val = config.get("combatRounds") or config.get("combat_rounds") or combat_input.get("combat_rounds") or mirror_combat.get("combat_rounds")
    
    dispatch_all_val = config.get("dispatchAllMarches")
    if dispatch_all_val is None:
        dispatch_all_val = config.get("dispatch_all_marches")
    if dispatch_all_val is None:
        dispatch_all_val = combat_input.get("dispatch_all_marches")
    if dispatch_all_val is None:
        dispatch_all_val = mirror_combat.get("dispatch_all_marches")

    min_barb_lvl = config.get("min_barb_level") or combat_input.get("min_barb_level")
    if min_barb_lvl is None and skip_barbs_below_val and skip_barbs_below_val != "None":
        try:
            min_barb_lvl = int(str(skip_barbs_below_val).replace("L", ""))
        except Exception:
            pass

    max_barb_lvl = config.get("max_barb_level") or combat_input.get("max_barb_level")
    if max_barb_lvl is None and highest_barb_level_val and highest_barb_level_val != "Max Unlocked":
        try:
            max_barb_lvl = int(str(highest_barb_level_val).replace("L", ""))
        except Exception:
            pass

    max_marches = config.get("max_combat_marches") or combat_input.get("max_combat_marches")
    if max_marches is None and dispatch_all_val is not None:
        max_marches = 5 if bool(dispatch_all_val) else 1

    combat_patch = {
        "barbs": bool(barbs_val) if barbs_val is not None else None,
        "highest_barb_level": str(highest_barb_level_val) if highest_barb_level_val is not None else None,
        "skip_barbs_below": str(skip_barbs_below_val) if skip_barbs_below_val is not None else None,
        "primary_commander": str(primary_cmd_val) if primary_cmd_val is not None else None,
        "secondary_commander": str(secondary_cmd_val) if secondary_cmd_val is not None else None,
        "combat_rounds": int(combat_rounds_val) if combat_rounds_val is not None else None,
        "dispatch_all_marches": bool(dispatch_all_val) if dispatch_all_val is not None else None,
        "min_barb_level": min_barb_lvl,
        "max_barb_level": max_barb_lvl,
        "max_combat_marches": max_marches,
        "hold_position": config.get("hold_position", combat_input.get("hold_position", config.get("hold_position_after_attack"))),
    }
    combat_patch = {k: v for k, v in combat_patch.items() if v is not None}
    hospital_patch = config.get("hospital") or {
        "heal_troops": config.get("healTroops", config.get("heal_troops")),
        "heal_batch": config.get("healBatch", config.get("heal_batch"))
    }
    hospital_patch = {k: v for k, v in hospital_patch.items() if v is not None}
    alliance_input = config.get("alliance") if isinstance(config.get("alliance"), dict) else {}
    mirror_alliance = (config.get("mirror") or {}).get("alliance", {}) if isinstance(config.get("mirror"), dict) else {}
    
    donate_val = None
    for k in ("donateTech", "donate_tech", "donate_to_tech", "alliance_donate_tech", "tech_donation"):
        if k in alliance_input and alliance_input[k] is not None:
            donate_val = bool(alliance_input[k])
            break
        if k in config and config[k] is not None:
            donate_val = bool(config[k])
            break
        if k in mirror_alliance and mirror_alliance[k] is not None:
            donate_val = bool(mirror_alliance[k])
            break

    alliance_patch = {
        "help_alliance_members": config.get("allianceHelp", config.get("help_alliance_members", alliance_input.get("help_alliance_members", mirror_alliance.get("one_click_help")))),
        "gather_resource_pit": config.get("alliancePit", config.get("gather_alliance_resource_pit", alliance_input.get("gather_resource_pit"))),
        "donate_tech": donate_val if donate_val is not None else alliance_input.get("donate_tech"),
        "claim_gifts": config.get("allianceGifts", config.get("claim_alliance_gifts", alliance_input.get("claim_gifts")))
    }
    alliance_patch = {k: v for k, v in alliance_patch.items() if v is not None}
    daily_patch = config.get("daily_claims") or {
        "vip_chest": config.get("vipChest", config.get("vip_chest")),
        "auto_scout": config.get("autoScout", config.get("auto_scout")),
        "daily_quest_chests": config.get("dailyQuestChests", config.get("daily_quest_chests")),
        "chronicle": config.get("chronicle", True)
    }
    daily_patch = {k: v for k, v in daily_patch.items() if v is not None}
    city_patch = config.get("city") or {
        "collect_resources": config.get("collectCity", config.get("collect_resources"))
    }
    city_patch = {k: v for k, v in city_patch.items() if v is not None}
    gather_patch = config.get("gather") or config.get("gathering") or {}
    # Training / Tiers extraction
    tiers_patch = config.get("tiers") or config.get("train") or config.get("training") or {}
    raw_inf = config.get("trainInfantry") or config.get("infantry") or (tiers_patch.get("infantry") if isinstance(tiers_patch, dict) else None)
    raw_cav = config.get("trainCavalry") or config.get("cavalry") or (tiers_patch.get("cavalry") if isinstance(tiers_patch, dict) else None)
    raw_arch = config.get("trainArchers") or config.get("archers") or config.get("archery") or (tiers_patch.get("archery") or tiers_patch.get("archers") if isinstance(tiers_patch, dict) else None)
    raw_sge = config.get("trainSiege") or config.get("siege") or (tiers_patch.get("siege") if isinstance(tiers_patch, dict) else None)
    
    if raw_inf is not None or raw_cav is not None or raw_arch is not None or raw_sge is not None:
        tiers_normalized = {}
        for cat, val in [("infantry", raw_inf), ("cavalry", raw_cav), ("archery", raw_arch), ("siege", raw_sge)]:
            if val is not None:
                v_str = str(val).strip().lower()
                if v_str in ("off", "none", "disabled", "false", "0"):
                    tiers_normalized[cat] = "off"
                else:
                    tiers_normalized[cat] = v_str
        tiers_patch = tiers_normalized

    auto_train = config.get("autoTrainTroops")
    if auto_train is None:
        auto_train = config.get("training_enabled")
    if auto_train is not None:
        BotSettingsDAO.set("training_enabled", "true" if auto_train else "false", user_id)

    if tiers_patch:
        existing_train_raw = BotSettingsDAO.get("train_config", user_id=user_id)
        existing_train = {}
        if existing_train_raw:
            try:
                existing_train = json.loads(existing_train_raw)
            except Exception:
                pass
        existing_train["tiers"] = {**(existing_train.get("tiers") or {}), **tiers_patch}
        if auto_train is not None:
            existing_train["enabled"] = bool(auto_train)
        BotSettingsDAO.set("train_config", json.dumps(existing_train), user_id)

    target_chars = []
    if (scope == "role" or role_id) and role_id:
        c = CharacterDAO.get_by_role_id(str(role_id), user_id)
        if c:
            target_chars.append(c)
    elif (scope in ("email", "account") or email) and email:
        acc = AccountDAO.get_by_email(str(email), user_id)
        if acc:
            target_chars = CharacterDAO.get_by_account_id(acc["id"])
    else:
        # All fleet accounts
        target_chars = CharacterDAO.get_all(user_id=user_id)
    updated_count = 0
    for ch in target_chars:
        CharacterSettingsDAO.upsert(
            character_id=ch["id"],
            tiers=tiers_patch if tiers_patch else None,
            gather=gather_patch if gather_patch else None,
            combat=combat_patch if combat_patch else None,
            hospital=hospital_patch if hospital_patch else None,
            alliance=alliance_patch if alliance_patch else None,
            daily_claims=daily_patch if daily_patch else None,
            city=city_patch if city_patch else None
        )
        updated_count += 1
    return {
        "success": True,
        "bot_id": bot_id,
        "scope": scope,
        "email": email,
        "role_id": role_id,
        "characters_updated": updated_count
    }

