def _format_relative_time(dt_str: Optional[str], is_future: bool = False) -> str:
    if not dt_str:
        return "Never" if not is_future else "-"
    try:
        dt = datetime.datetime.strptime(dt_str, "%Y-%m-%d %H:%M:%S")
        now = datetime.datetime.now()
        diff = (now - dt).total_seconds() if not is_future else (dt - now).total_seconds()
        if diff < 0:
            diff = 0
        if diff < 60:
            return f"{int(diff)}s ago" if not is_future else f"in {int(diff)}s"
        elif diff < 3600:
            m = int(diff // 60)
            return f"{m}m ago" if not is_future else f"in {m}m"
        elif diff < 86400:
            h = int(diff // 3600)
            m = int((diff % 3600) // 60)
            return f"{h}h {m}m ago" if not is_future else f"in {h}h {m}m"
        else:
            d = int(diff // 86400)
            return f"{d}d ago" if not is_future else f"in {d}d"
    except Exception:
        return dt_str


def _resolve_character(identifier: str, user_id: str):
    """Resolve character by DB id (int) or role_id (string). Enforces tenant ownership."""
    # Try DB id first if numeric
    try:
        if str(identifier).isdigit():
            from app.database import get_db_connection
            con = get_db_connection()
            row = con.execute("SELECT * FROM characters WHERE id = ?", (int(identifier),)).fetchone()
            if row:
                char = dict(row)
                # Verify tenant owns it
                if CharacterDAO.owns_character(user_id, char["role_id"]):
                    return char
    except Exception:
        pass
    # Fallback to role_id lookup (tenant-scoped)
    return CharacterDAO.get_by_role_id(str(identifier), user_id)

def _build_targets_from_config(gather_cfg: dict):
    """Build march_targets list from web Config Gathering tab."""
    targets = []
    def _cnt(key):
        # Support both food_marches and food — prefer direct count if present and differs
        # Check for explicit march count first, but also sync legacy keys
        v_marches = gather_cfg.get(f"{key}_marches")
        v_direct = gather_cfg.get(key)
        # If both are present and differ, prefer the direct food value if it was recently set via PUT
        # (PUT with food:2 should override food_marches:1). Check if direct is not None.
        if v_direct is not None:
            try:
                # If direct was explicitly set, use it
                return max(0, int(v_direct))
            except:
                pass
        if v_marches is not None:
            try:
                return max(0, int(v_marches))
            except:
                pass
        if v_direct is not None:
            try:
                return max(0, int(v_direct))
            except:
                pass
        return 0
    for res in ["food", "wood", "stone", "gold"]:
        cnt = _cnt(res)
        for _ in range(cnt):
            targets.append(res)
    if not targets:
        pri = gather_cfg.get("priority_types")
        if isinstance(pri, list) and pri:
            targets = [p for p in pri if p in ["food","wood","stone","gold"]][:4]
    # Also handle gem if ever enabled (should be banned, but keep)
    if not targets:
        # Check for enabled gem (should be 0)
        if gather_cfg.get("gem",0):
            for _ in range(int(gather_cfg.get("gem",0))):
                targets.append("gold")  # fallback gold
    if not targets:
        targets = ["food","wood","stone"]
    return targets


