    """
    char = CharacterDAO.get_by_role_id(req.role_id, user_id)
    if not char:
        raise HTTPException(status_code=404, detail="Character not found")

    # Save to SQLite database
    gather_prefs = {
        "food": req.food,
        "wood": req.wood,
        "stone": req.stone,
        "gold": req.gold,
        "max_node_level": req.max_node_level,
