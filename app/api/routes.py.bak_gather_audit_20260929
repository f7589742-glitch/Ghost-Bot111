def _normalize_bot_id(bot_id: Optional[str] = None) -> str:
    bid = str(bot_id or "").strip()
    if not bid:
        return "bot-1"
    if bid.isdigit():
        return f"bot-{bid}"
    return bid

def _resolve_tenant_uid(user_id: Optional[str] = None, bot_id: Optional[str] = None, request: Optional[Request] = None) -> str:
    uid = (user_id or "").strip()
    if request:
        auth_header = request.headers.get("authorization", "").strip()
        if auth_header.startswith("Bearer "):
            token = auth_header.split(" ", 1)[1].strip()
            try:
                from app.core.auth import decode_supabase_jwt
                claims = decode_supabase_jwt(token)
                sub = claims.get("sub") or claims.get("user_id")
                if sub:
                    return str(sub).strip()
            except Exception:
                pass
        if not uid or uid in ("dev-operator", "undefined", "null"):
            uid = request.headers.get("x-user-id", "").strip() or request.query_params.get("user_id", "").strip()
    if not uid or uid in ("dev-operator", "undefined", "null"):
        return ""
    return uid




@router.post("/bot/{bot_id}/start")
async def start_bot_unit(bot_id: str, request: Request, user_id: Optional[str] = Query(None)):
    target_bot_id = _normalize_bot_id(bot_id)
    req_uid = request.headers.get("x-user-id", "").strip() or (user_id or "").strip()
    uid = _resolve_tenant_uid(req_uid, target_bot_id, request)
    if not uid:
        raise HTTPException(status_code=401, detail="Tenant authentication required")
    
    # Activate and dynamically bind accounts to this user and bot_id (never touch shoob accounts)
    try:
        from app.database import get_db_connection
        con = get_db_connection()
        with con:
            con.execute("UPDATE accounts SET is_active = 0 WHERE LOWER(email) LIKE '%shoob%'")
            # Check if this uid already owns matching accounts
            uid_count = con.execute("SELECT count(*) FROM accounts WHERE user_id = ? AND LOWER(email) NOT LIKE '%shoob%'", (uid,)).fetchone()
            if not uid_count or uid_count[0] == 0:
                # Fallback: check if accounts exist with target_bot_id
                bids = [target_bot_id]
                if target_bot_id.startswith("bot-"): bids.append(target_bot_id[4:])
                else: bids.append(f"bot-{target_bot_id}")
                placeholders = ",".join("?" for _ in bids)
                bot_count = con.execute(f"SELECT count(*) FROM accounts WHERE bot_id IN ({placeholders}) AND LOWER(email) NOT LIKE '%shoob%'", tuple(bids)).fetchone()
                if bot_count and bot_count[0] > 0:
                    con.execute(f"UPDATE accounts SET user_id = ?, bot_id = ?, is_active = 1 WHERE bot_id IN ({placeholders}) AND LOWER(email) NOT LIKE '%shoob%'", (uid, target_bot_id, *bids))
                else:
                    raise HTTPException(status_code=400, detail="No accounts linked to this unit. Please link an account first.")
            else:
                con.execute(
                    "UPDATE accounts SET is_active = 1, bot_id = ?, next_run = NULL WHERE user_id = ? AND LOWER(email) NOT LIKE '%shoob%'",
                    (target_bot_id, uid)
                )

            con.execute(
                "UPDATE characters SET enabled = 1, next_run = NULL WHERE account_id IN (SELECT id FROM accounts WHERE user_id = ? AND LOWER(email) NOT LIKE '%shoob%') AND LOWER(name) NOT LIKE '%shoob%'",
                (uid,)
            )
    except Exception as e_assign:
        logger.warning(f"Error activating accounts for {target_bot_id}: {e_assign}")

    BotSettingsDAO.set(f"bot_running_{target_bot_id}", "true", user_id=uid)
    BotSettingsDAO.set("bot_running", "true", user_id=target_bot_id)
    BotSettingsDAO.set("bot_running", "true", user_id=uid)

    from app.services.scheduler import start_master_scheduler, force_reset_execution_locks
    force_reset_execution_locks()
    start_master_scheduler()

    sched = get_scheduler(user_id=uid, bot_id=target_bot_id)
    sched.reset_cooldowns()
    sched._ensure_accounts_bound()
    sched.start()
    if sched._wake_event:
        sched._wake_event.set()

    lang = BotSettingsDAO.get("ui_language", "ar", user_id=uid).lower()
    is_ar = "ar" in lang or not ("en" in lang)
    start_msg = (
        f"⚡ بدء تشغيل دورة الفحص المرحلية للوحدة {target_bot_id} (المرحلة 1: الحكام الأساسيون -> المرحلة 2: الحكام الثانويون)..."
        if is_ar
        else f"⚡ Starting autonomous staged sweep for {target_bot_id} (Slot 1 Primary -> Slot 2 Secondary)..."
    )
    TenantActivityStream.emit(target_bot_id, None, start_msg, user_id=uid)
    await activity_stream.broadcast(start_msg, user_id=uid)

    return {"status": "ok", "success": True, "running": True, "bot_id": target_bot_id}


