        task_id=task_id,
        role_id=role_id,
        task_type="train",
        params={
            "categories": categories,
            "percentage": train_pct,
            "count": train_count_custom,
            "tiers": tiers or {},
            "auto_collect": True
        },
        user_id=user_id
    )
    return {"success": True, "task_id": task_id, "role_id": role_id, "character_name": char.get("name"), "categories": categories, "status": "RUNNING", "message": f"Training dispatched for {char.get('name')}"}


