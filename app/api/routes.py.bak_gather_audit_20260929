@router.put("/characters/{role_id}/commanders")
def save_character_commanders(role_id: str, payload: Dict[str, Any], user_id: str = Query(...)):
    """Saves the unlocked commander roster (discovered in-game) for a character."""
    char = CharacterDAO.get_by_role_id(role_id, user_id)
    if not char:
        raise HTTPException(status_code=404, detail="Character not found")
