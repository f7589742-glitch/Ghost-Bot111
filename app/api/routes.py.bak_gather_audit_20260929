@router.get("/marches", response_model=GatherStatusResponse)
def get_marches(user_id: str = Query(...)):
    """Retrieve this tenant's real-time gathering marches status."""
    base_dir = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
    tenant_file = os.path.join(base_dir, "tenants", user_id, "gather_status.json")
    status_file = tenant_file if os.path.exists(tenant_file) else os.path.join(base_dir, "gather_status.json")

    active_marches_count = 0
    total_city_troops = 0
    raw_marches = []
    last_update = None

    if os.path.exists(status_file):
        try:
            with open(status_file, "r", encoding="utf-8") as f:
                data = json.load(f)
                active_marches_count = data.get("active_marches_count", 0)
                total_city_troops = data.get("total_city_troops", 0)
                raw_marches = data.get("marches", [])
                last_update = data.get("last_update")
        except Exception:
            pass

    max_queues = 5
    marches_out = []
    for i in range(max_queues):
        if i < len(raw_marches):
            m = raw_marches[i]
            marches_out.append(MarchInfo(
                queue_id=i + 1,
                cmd_id=m.get("cmd_id"),
                sec_cmd_id=m.get("sec_cmd_id"),
                cmd_name=m.get("cmd_name") or f"Commander #{m.get('cmd_id')}",
                type=m.get("type", "food"),
                target=m.get("target", "Resource Tile"),
                troops=int(m.get("troops", 0)),
                load=int(m.get("load", 0)),
                node_reserves=int(m.get("node_reserves", 0)),
                status=m.get("status", "Gathering")
            ))
        else:
            marches_out.append(MarchInfo(
                queue_id=i + 1,
                cmd_id=None,
                cmd_name="Unassigned",
                type="idle",
                target="Ready to deploy",
                troops=0,
                load=0,
                node_reserves=0,
                status="IDLE"
            ))

    return GatherStatusResponse(
        active_marches_count=active_marches_count,
        max_queues=max_queues,
        total_city_troops=total_city_troops,
        marches=marches_out,
        last_update=last_update
    )


