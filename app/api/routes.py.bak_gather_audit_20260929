@router.put("/characters/{role_id}/settings", response_model=CharacterSettingsResponse)
def update_character_settings(role_id: str, req: CharacterSettingsRequest, user_id: str = Query(...)):
    """Saves automation settings for a character (used by train/gather tasks)."""
    char = CharacterDAO.get_by_role_id(role_id, user_id)
    if not char:
        raise HTTPException(status_code=404, detail="Character not found")
    if req.clear_custom_count:
        s = CharacterSettingsDAO.clear_custom_count(char["id"])
    else:
        s = CharacterSettingsDAO.get_by_character_id(char["id"])
    s = CharacterSettingsDAO.upsert(
        char["id"], train_pct=req.train_pct,
        train_count_custom=req.train_count_custom,
        tiers=req.tiers, gather=req.gather,
        combat=req.combat, hospital=req.hospital,
        alliance=req.alliance, daily_claims=req.daily_claims,
        city=req.city)
    return CharacterSettingsResponse(
        character_id=char["id"], role_id=str(role_id),
        train_pct=s.get("train_pct", 100),
        train_count_custom=s.get("train_count_custom"),
        tiers=s.get("tiers") or {}, gather=s.get("gather") or {},
        combat=s.get("combat") or {}, hospital=s.get("hospital") or {},
        alliance=s.get("alliance") or {}, daily_claims=s.get("daily_claims") or {},
        city=s.get("city") or {},
    )

