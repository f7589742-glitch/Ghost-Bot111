@router.post("/characters/{role_id}/run-task")
def run_character_task(role_id: str, req: CharacterTaskRequest, bg_tasks: BackgroundTasks, user_id: str = Query(...)):
    """
    Dispatch a headless game socket task (sync_full, train, gather, alliance_help)
    in the background.
    """
    char = CharacterDAO.get_by_role_id(role_id, user_id)
    if not char:
        raise HTTPException(status_code=404, detail="Character not found")

    task_id = f"task_{uuid.uuid4().hex[:12]}"
    TaskLogDAO.create(
        task_id=task_id,
        role_id=role_id,
        task_type=req.task_name,
        status="RUNNING",
        details={"params": req.params},
        character_id=char["id"]
    )

    bg_tasks.add_task(
        GameSocketWorker.run_character_task,
        task_id=task_id,
        role_id=role_id,
        task_type=req.task_name,
        params=req.params,
        user_id=user_id
    )

    return {
        "success": True,
        "task_id": task_id,
        "role_id": role_id,
        "task_name": req.task_name,
        "status": "RUNNING",
        "message": f"Task '{req.task_name}' queued for execution via TCP gateway"
    }

