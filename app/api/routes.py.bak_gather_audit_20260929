    role_id = str(char["role_id"])
    settings = CharacterSettingsDAO.get_by_character_id(char["id"])
    tiers = settings.get("tiers") or {}
    train_pct = settings.get("train_pct", 100)
    train_count_custom = settings.get("train_count_custom")
    # Allow payload override for training
    if payload and isinstance(payload, dict):
        if "tiers" in payload:
            tiers = payload["tiers"]
        if "train_pct" in payload or "capacity_mode" in payload:
            train_pct = payload.get("train_pct", payload.get("capacity_mode", train_pct))
            if str(train_pct).lower() == "max":
                train_pct = 100
        if "train_count_custom" in payload:
            train_count_custom = payload["train_count_custom"]
    categories = []
    for cat in ["infantry","cavalry","archery","siege"]:
        # Check both tiers dict and training dict
        tier_val = tiers.get(cat) if isinstance(tiers, dict) else None
        # If training dict exists, check enabled
