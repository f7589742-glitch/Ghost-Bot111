    """Save troop training configurations (tenant-scoped)."""
    target_scope = payload.get("scope", "all")
    account_id = payload.get("account_id")
    role_id = payload.get("role_id")
    train_data = payload.get("train") or payload.get("training") or {}

    enabled = bool(train_data.get("enabled", True))
    auto_collect = bool(train_data.get("auto_collect", True))
    raw_pct = train_data.get("train_pct", 100)
    train_pct = max(1, min(100, int(raw_pct))) if raw_pct is not None else 100
    custom_count = train_data.get("train_count_custom")
    train_count_custom = int(custom_count) if custom_count is not None and str(custom_count).isdigit() and int(custom_count) > 0 else None

    # Tiers dict normalization (infantry, cavalry, archery, siege)
    raw_tiers = train_data.get("tiers") or {}
    if not raw_tiers:
        raw_tiers = {
            "infantry": train_data.get("infantry") or train_data.get("trainInfantry"),
            "cavalry": train_data.get("cavalry") or train_data.get("trainCavalry"),
            "archery": train_data.get("archery") or train_data.get("archers") or train_data.get("trainArchers"),
            "siege": train_data.get("siege") or train_data.get("trainSiege"),
        }
    tiers = {}
    for cat in ("infantry", "cavalry", "archery", "siege"):
        v_val = raw_tiers.get(cat)
        if v_val is None and cat == "archery":
            v_val = raw_tiers.get("archers")
        v = str(v_val if v_val is not None else "t1").strip().lower()
        if v in ("off", "none", "disabled", "false", "0"):
            tiers[cat] = "off"
        elif v in ("t1", "1"):
            tiers[cat] = "t1"
        elif v in ("t2", "2"):
            tiers[cat] = "t2"
        elif v in ("t3", "3"):
            tiers[cat] = "t3"
        elif v in ("t4", "4"):
            tiers[cat] = "t4"
        elif v in ("t5", "5"):
            tiers[cat] = "t5"
        else:
            tiers[cat] = v

    normalized_train = {
        "enabled": enabled,
        "auto_collect": auto_collect,
        "train_pct": train_pct,
        "train_count_custom": train_count_custom,
        "tiers": tiers
    }

    BotSettingsDAO.set("train_config", json.dumps(normalized_train), user_id)
    BotSettingsDAO.set("training_enabled", "true" if enabled else "false", user_id)

    if target_scope == "all":
        chars = CharacterDAO.get_all(user_id=user_id)
        if not chars:
            chars = CharacterDAO.get_all()
        for c in chars:
            CharacterSettingsDAO.upsert(
                c["id"],
                train_pct=train_pct,
                train_count_custom=train_count_custom,
                tiers=tiers
            )
    elif target_scope == "account" and account_id and str(account_id) != "all":
        acc = AccountDAO.get_by_id(int(account_id), user_id)
        if not acc:
            acc = AccountDAO.get_by_id(int(account_id))
        if acc:
            chars = CharacterDAO.get_by_account_id(int(account_id))
            for c in chars:
                CharacterSettingsDAO.upsert(
                    c["id"],
                    train_pct=train_pct,
                    train_count_custom=train_count_custom,
                    tiers=tiers
                )
    elif role_id:
        char = CharacterDAO.get_by_role_id(str(role_id), user_id)
        if not char:
            char = CharacterDAO.get_by_role_id(str(role_id))
        if char:
            CharacterSettingsDAO.upsert(
                char["id"],
                train_pct=train_pct,
                train_count_custom=train_count_custom,
                tiers=tiers
            )

    return {"success": True, "train": normalized_train}


