_DEFAULT_GATHER_SEED = {
    "food": 1, "wood": 1, "stone": 1, "gold": 0, "gem": 0,
    "max_node_level": "Level 6 and below",
    "only_finishable": True, "skip_partially": True,
    "max_marches": "auto", "territory": "alliance_preferred",
    "avoid_territory": True,
    "recall_on_attack": True,
    "node_min_level": 2, "node_max_level": 5,
