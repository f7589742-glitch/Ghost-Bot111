@router.post("/accounts/prune-characters")
def prune_account_characters(payload: Dict[str, Any], user_id: Optional[str] = Query(None)):
    """Keep ONLY the given role_ids on an account; delete every other character
    (+ its settings). Used by the Add-dialog picker so deselected characters
    never reach the scheduler. Body: {"email"|"account_id", "keep_role_ids": [...]}.
    """
    uid = (user_id or (payload or {}).get("user_id") or "").strip()
    keep = {str(r) for r in ((payload or {}).get("keep_role_ids") or [])}
    acc = None
    if (payload or {}).get("account_id") is not None:
        try:
            acc = AccountDAO.get_by_id(int(payload["account_id"]), uid if uid else None)
        except Exception:
            acc = None
    if acc is None and (payload or {}).get("email"):
        em = str(payload["email"]).strip().lower()
        acc = AccountDAO.get_by_email(em, uid if uid else None)
        if not acc:
            con = get_db_connection()
            row = con.execute("SELECT * FROM accounts WHERE LOWER(email) = ?", (em,)).fetchone()
            acc = dict(row) if row else None
    if not acc:
        raise HTTPException(status_code=404, detail="Account not found")
    removed = []
    for c in CharacterDAO.get_by_account_id(acc["id"]):
        if str(c.get("role_id")) not in keep:
            CharacterDAO.delete(str(c["role_id"]), acc.get("user_id") or uid or None)
            removed.append(str(c["role_id"]))
    return {"success": True, "account_id": acc["id"], "kept": sorted(keep), "removed": removed}


