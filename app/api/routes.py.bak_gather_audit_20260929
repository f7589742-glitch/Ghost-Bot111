@router.get("/fleet/overview")
def fleet_overview(request: Request, user_id: Optional[str] = Query(None)):
    """Fleet-wide metrics grouped by kingdom (accordion view). Scoped by tenant."""
    from app.models import InventoryDAO, AccountDAO, RunHistoryDAO
    req_uid = request.headers.get("x-user-id", "").strip() or (user_id or "").strip()
    uid = _resolve_tenant_uid(req_uid, None, request)
    if not uid:
        return {"total_instances": 0, "instances": [], "gathered_today": {"food": 0, "wood": 0, "stone": 0, "gold": 0}}
    instances: Dict[str, Dict[str, Any]] = {}
    con = get_db_connection()
    rows = con.execute("""
        SELECT bot_id, COUNT(*) AS chars,
               SUM(food) AS food, SUM(wood) AS wood, SUM(stone) AS stone, SUM(gold) AS gold,
               SUM(power) AS power
        FROM character_inventories 
        WHERE user_id = ?
        GROUP BY bot_id
    """, (uid,)).fetchall()
    for r in rows:
        bid = r["bot_id"] or ""
        instances.setdefault(bid, {
            "bot_id": bid, "characters": int(r["chars"] or 0),
            "food": int(r["food"] or 0), "wood": int(r["wood"] or 0),
            "stone": int(r["stone"] or 0), "gold": int(r["gold"] or 0),
            "power": int(r["power"] or 0), "kingdoms": {},
        })
    krows = con.execute("""
        SELECT bot_id, kingdom_id, COUNT(*) AS chars, SUM(power) AS power,
               SUM(food + wood + stone + gold) AS rss
        FROM character_inventories 
        WHERE user_id = ?
        GROUP BY bot_id, kingdom_id
    """, (uid,)).fetchall()
    for r in krows:
        inst = instances.get(r["bot_id"] or "")
        if inst:
            inst["kingdoms"][str(r["kingdom_id"])] = {
                "characters": int(r["chars"] or 0), "power": int(r["power"] or 0),
                "rss": int(r["rss"] or 0),
            }
    today_total = {"food": 0, "wood": 0, "stone": 0, "gold": 0}
    for bid in instances:
        agg = RunHistoryDAO.aggregated_gathered(bid, 1, user_id=uid)
        for k in today_total:
            today_total[k] += agg.get(k, 0)
    return {
        "total_instances": len(instances),
        "instances": list(instances.values()),
        "gathered_today": today_total,
    }
