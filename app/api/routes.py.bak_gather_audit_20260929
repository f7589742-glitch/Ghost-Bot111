    start_master_scheduler()
    
    is_run = sched.is_running() or BotSettingsDAO.is_bot_running(target_bot_id, real_uid)
    if is_run and not sched._running:
        sched._running = True
        try:
            loop = asyncio.get_running_loop()
            if not sched._task or sched._task.done():
                sched._task = loop.create_task(sched._run_loop())
        except RuntimeError:
            pass

    return {
        "running": is_run,
        "status": "running" if is_run else "stopped",
        "bot_id": target_bot_id,
        "settings": BotSettingsDAO.get_all(real_uid)
    }



