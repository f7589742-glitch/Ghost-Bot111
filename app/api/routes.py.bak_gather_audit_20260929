@router.post("/config/gather")
def save_gather_config(payload: Dict[str, Any], user_id: str = Query(...)):
    """Save gathering configurations (tenant-scoped)."""
    target_scope = payload.get("scope", "all")
    account_id = payload.get("account_id")
    role_id = payload.get("role_id")
    gather_data = payload.get("gather", {})

    # Detect user's territory avoidance setting from all frontend key variants
    if "avoid_enemy_territory" in gather_data:
        avoid_t = bool(gather_data["avoid_enemy_territory"])
    elif "avoidEnemyTerritory" in gather_data:
        avoid_t = bool(gather_data["avoidEnemyTerritory"])
    elif "avoid_other_alliance_territories" in gather_data:
        avoid_t = bool(gather_data["avoid_other_alliance_territories"])
    elif "avoid_territory" in gather_data:
        avoid_t = bool(gather_data["avoid_territory"])
    elif gather_data.get("territory") == "open_world":
        avoid_t = False
    elif gather_data.get("territory") == "alliance_preferred":
        avoid_t = True
    else:
        avoid_t = True

    # Synchronize across all known keys so every backend consumer reads the exact state
    gather_data["avoid_territory"] = avoid_t
    gather_data["avoid_enemy_territory"] = avoid_t
    gather_data["avoidEnemyTerritory"] = avoid_t
    gather_data["avoid_other_alliance_territories"] = avoid_t
    gather_data["territory"] = "alliance_preferred" if avoid_t else "open_world"

    # Synchronize skip_partially across all frontend key variants
    if "skip_partially" in gather_data:
        skip_p = bool(gather_data["skip_partially"])
    elif "skip_partially_gathered" in gather_data:
        skip_p = bool(gather_data["skip_partially_gathered"])
    elif "skip_partially_gathered_nodes" in gather_data:
        skip_p = bool(gather_data["skip_partially_gathered_nodes"])
    elif "skip_partially_depleted" in gather_data:
        skip_p = bool(gather_data["skip_partially_depleted"])
    elif "skipPartial" in gather_data:
        skip_p = bool(gather_data["skipPartial"])
    else:
        skip_p = True

    gather_data["skip_partially"] = skip_p
    gather_data["skip_partially_gathered"] = skip_p
    gather_data["skip_partially_gathered_nodes"] = skip_p
    gather_data["skip_partially_depleted"] = skip_p
    gather_data["skipPartial"] = skip_p

    # Synchronize auto_balance across all variants
    if "auto_balance" in gather_data:
        auto_b = bool(gather_data["auto_balance"])
    elif "auto_balance_lowest_rss" in gather_data:
        auto_b = bool(gather_data["auto_balance_lowest_rss"])
    elif "autoBalanceLowest" in gather_data:
        auto_b = bool(gather_data["autoBalanceLowest"])
    elif "prioritize_lowest_rss" in gather_data:
        auto_b = bool(gather_data["prioritize_lowest_rss"])
    else:
        auto_b = False

    gather_data["auto_balance"] = auto_b
    gather_data["auto_balance_lowest_rss"] = auto_b
    gather_data["prioritize_lowest_rss"] = auto_b

    # Synchronize per-resource march counts cleanly and honestly
    marches_map = gather_data.get("marches") if isinstance(gather_data.get("marches"), dict) else {}
    for r in ["food", "wood", "stone", "gold"]:
        val = gather_data.get(r)
        cnt = None
        if isinstance(val, bool):
            cnt = 1 if val else 0
        elif isinstance(val, (int, float)):
            cnt = max(0, int(val))
        elif isinstance(val, str) and val.isdigit():
            cnt = max(0, int(val))
        elif f"{r}_marches" in gather_data:
            try:
                cnt = max(0, int(gather_data[f"{r}_marches"]))
            except Exception:
                cnt = None
        elif r in marches_map:
            try:
                cnt = max(0, int(marches_map[r]))
            except Exception:
                cnt = None

        if cnt is None:
            cnt = 1 if r in ("food", "wood", "stone") else 0

        gather_data[r] = (cnt > 0)
        gather_data[f"{r}_marches"] = cnt
        marches_map[r] = cnt

    gather_data["marches"] = marches_map

    # Synchronize max_node_level / max_level
    raw_max_lvl = gather_data.get("max_node_level")
    if raw_max_lvl is None:
        raw_max_lvl = gather_data.get("max_level")
    if raw_max_lvl is not None:
        gather_data["max_node_level"] = raw_max_lvl
        gather_data["max_level"] = raw_max_lvl

    BotSettingsDAO.set("gather_config", json.dumps(gather_data), user_id)
    if target_scope == "all":
        chars = CharacterDAO.get_all(user_id=user_id)
        for c in chars:
            CharacterSettingsDAO.upsert(c["id"], gather=gather_data)
    elif target_scope == "account" and account_id and str(account_id) != "all":
        acc = AccountDAO.get_by_id(int(account_id), user_id)
        if acc:
            chars = CharacterDAO.get_by_account_id(int(account_id))
            for c in chars:
                CharacterSettingsDAO.upsert(c["id"], gather=gather_data)
    elif role_id:
        char = CharacterDAO.get_by_role_id(str(role_id), user_id)
        if char:
            CharacterSettingsDAO.upsert(char["id"], gather=gather_data)
    return {"success": True, "gather": gather_data}


