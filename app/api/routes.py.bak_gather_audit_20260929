@router.get("/log/stream")
@router.get("/backend/api/log/stream")
def stream_logs(request: Request, user_id: Optional[str] = Query(None), bot_id: Optional[str] = Query(None)):
    """Live RAW engine-log push over Server-Sent Events (debug view).
    Strictly isolated per tenant user_id and bot_id.
    """
    import queue as _queue
    from fastapi.responses import StreamingResponse
    from app.services.activity_stream import activity_stream as _stream
    from app.services.activity_logger import TenantActivityStream

    req_uid = request.headers.get("x-user-id", "").strip() or (user_id or "").strip()
    bid = _normalize_bot_id(bot_id) if bot_id else "bot-1"
    uid = _resolve_tenant_uid(req_uid, bid, request)

    q = _stream.subscribe(raw=True, user_id=uid)
    def _gen():
        try:
            backlog = []
            if uid:
                backlog = list(TenantActivityStream.get_buffer(bid, user_id=uid) or [])
                if not backlog:
                    backlog = list(_stream.get_recent(uid) or [])
            for line in backlog[-100:]:
                yield f"data: {line}\n\n"
            yield "data: __READY__\n\n"
            heartbeat = 0.0
            while True:
                try:
                    line = q.get(timeout=15.0)
                    if line:
                        yield f"data: {line}\n\n"
                except _queue.Empty:
                    heartbeat += 1
                    yield ": keep-alive\n\n"
        except GeneratorExit:
            pass
        finally:
            _stream.unsubscribe(q)
    return StreamingResponse(
        _gen(),
        media_type="text/event-stream",
        headers={
            "Cache-Control": "no-cache, no-transform",
            "X-Accel-Buffering": "no",
            "Connection": "keep-alive",
        },
    )


